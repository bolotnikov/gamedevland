---
interface Props {
	title: string;
	description: string;
	current?: 'home' | 'about';
}

const { title, description, current = 'home' } = Astro.props;
---

<header class="site-header">
	<div class="container">
		<nav class="top-nav">
			<a class="brand-pill" href="/">GameDev.Land</a>
			<div class="top-nav__links">
				<a class:list={['top-nav__link', current === 'home' && 'is-active']} href="/">Home</a>
				<a class:list={['top-nav__link', current === 'about' && 'is-active']} href="/about">About</a>
			</div>
		</nav>

		<div class="hero-block">
			<div class="hero-block__inner">
				<h1>{title}</h1>
				<p>{description}</p>
			</div>
		</div>
	</div>
</header>
