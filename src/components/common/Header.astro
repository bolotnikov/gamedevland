---
interface Props {
	title: string;
	description: string;
	current?: 'home' | 'games' | 'services' | 'about';
	compact?: boolean;
}

const { title, description, current = 'home', compact = false } = Astro.props;
---

<header class:list={['site-header', compact && 'is-compact']}>
	<div class="container">
		<nav class="top-nav">
			<a class="brand-pill" href="/">GameDev.Land</a>
			<div class="top-nav__links">
				<a class:list={['top-nav__link', current === 'home' && 'is-active']} href="/">Home</a>
				<a class:list={['top-nav__link', current === 'games' && 'is-active']} href="/games">Portfolio</a>
				<a class:list={['top-nav__link', current === 'services' && 'is-active']} href="/services">Services</a>
				<a class:list={['top-nav__link', current === 'about' && 'is-active']} href="/about">About</a>
			</div>
		</nav>

		<div class="hero-block">
			<div class="hero-block__inner">
				<h1>{title}</h1>
				<p>{description}</p>
			</div>
		</div>
	</div>
</header>
