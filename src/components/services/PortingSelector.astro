---
import { Locale } from '../../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
import { PortingOptions } from '../../data/PortingOptions';
---
<section class="porting-selector" id="porting" data-porting-selector aria-labelledby="porting-title">
 <div class="svc-section-heading"><div><span class="svc-eyebrow">{t("Исходная технология")}</span><h2 id="porting-title">{t("Откуда переносим игру?")}</h2></div></div>
 <form class="porting-form" aria-labelledby="porting-title">
  <fieldset class="porting-choices"><legend class="sr-only">{t("На чём создана игра")}</legend>
   {PortingOptions.sources.map((source, index) => <label class="porting-choice">
    <input type="radio" name="porting-source" value={source.id} checked={index === 0} aria-controls={`porting-${source.id}`}/>
    <span class={`choice-body choice-${source.id}`}><span class="choice-mark" aria-hidden="true">{source.mark}</span><span>{source.name}</span><span class="choice-check" aria-hidden="true">✓</span></span>
   </label>)}
  </fieldset>
 </form>
 <div class="porting-results" aria-live="polite" aria-atomic="true">
  {PortingOptions.sources.map(source => <article class="porting-result" id={`porting-${source.id}`} data-porting-panel={source.id}>
   <div class="porting-route" aria-label={t("Путь переноса")}>
    <div><span>{t("Исходная игра")}</span><strong>{source.name}</strong><small>{t(source.format)}</small></div><span class="route-arrow" aria-hidden="true">→</span>
    <div class="route-middle"><span>{t("Способ переноса")}</span><strong>{t(source.route)}</strong></div><span class="route-arrow" aria-hidden="true">→</span>
    <div class="route-web"><span>{t("Результат")}</span><strong>{t(source.result)}</strong><small>{t("Компьютеры · телефоны")}</small></div>
   </div>
   <div class="porting-detail">
    <div class="porting-approach"><span class="result-label">{source.name} → Web</span><h3>{t(source.title)}</h3><p>{t(source.description)}</p><ul>{source.focus.map(item => <li><span aria-hidden="true">✓</span>{t(item)}</li>)}</ul></div>
    <aside class="porting-brief"><span class="brief-icon" aria-hidden="true">&lt;/&gt;</span><h4>{t("Что нужно для оценки")}</h4><p>{t(source.materials)}</p><a class="svc-text-link" href={`mailto:alexander.bolotnikov@gmail.com?subject=${encodeURIComponent(t("Портирование игры: {name} → Web", {name: source.name}))}`}>{t("Обсудить перенос ")}<span aria-hidden="true">↗</span></a></aside>
   </div>
  </article>)}
 </div>
 <p class="porting-note">{t("Выбор показывает подход к задаче. Точный способ переноса и объём работ определяем после изучения игры.")}</p>
</section>
<script>
 import { PortingSelector } from '../../scripts/PortingSelector';
 for (const root of document.querySelectorAll<HTMLElement>('[data-porting-selector]')) new PortingSelector(root);
</script>
<style>
.porting-selector { padding:48px 0 64px; border-top:1px solid var(--color-border); }
.porting-form { padding:24px; background:var(--color-card); border:1px solid var(--color-border); border-radius:20px 20px 0 0; }
.porting-choices { padding:0; border:0; margin:0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; min-width:0; }
.porting-choice { position:relative; cursor:pointer; }
.porting-choice input { position:absolute; opacity:0; width:1px; height:1px; }
.choice-body { display:flex; align-items:center; gap:12px; padding:16px; min-height:72px; font-size:13px; font-weight:600; border:1px solid var(--color-border); border-radius:12px; background:var(--color-background); transition:border-color .2s,background .2s; }
.choice-mark { flex-shrink:0; display:grid; place-items:center; width:35px; height:35px; background:var(--color-secondary); border-radius:9px; color:var(--color-muted-foreground); font-size:15px; }
.choice-check { margin-left:auto; color:var(--svc-accent); visibility:hidden; }
.porting-choice input:checked+.choice-body { border-color:var(--svc-accent); background:color-mix(in srgb,var(--svc-accent) 7%,var(--color-card)); }
.porting-choice input:checked+.choice-body .choice-mark { color:var(--svc-accent); background:color-mix(in srgb,var(--svc-accent) 15%,var(--color-card)); }
.porting-choice input:checked+.choice-body .choice-check { visibility:visible; }
.porting-choice input:focus-visible+.choice-body { outline:3px solid var(--svc-accent); outline-offset:4px; }
.porting-choice:hover .choice-body { border-color:var(--svc-accent); }
.choice-flash .choice-mark { color:var(--color-amber); font-style:italic; font-size:24px; }
.porting-results { border:1px solid var(--color-border); border-top:0; border-radius:0 0 20px 20px; background:linear-gradient(130deg,var(--svc-tint),var(--color-card) 70%); overflow:hidden; }
.porting-result[hidden] { display:none; }
.porting-result:not(:first-child) { border-top:1px solid var(--color-border); }
.porting-selector.is-ready .porting-result { border-top:0; }
.porting-route { display:grid; grid-template-columns:1fr 44px 1fr 44px 1fr; padding:26px 32px; align-items:center; background:color-mix(in srgb,var(--svc-accent) 4%,var(--color-card)); border-bottom:1px solid var(--color-border); gap:8px; }
.porting-route>div { display:flex; flex-direction:column; gap:7px; min-width:0; }
.porting-route span:not(.route-arrow) { color:var(--color-muted-foreground); font-size:10px; }
.porting-route strong { font-size:13px; font-weight:600; line-height:1.5; }
.porting-route small { color:var(--color-muted-foreground); font-size:10px; line-height:1.6; }
.route-arrow { font-size:23px; color:var(--svc-accent); text-align:center; }
.route-web strong { color:var(--svc-accent); }
.porting-detail { display:grid; grid-template-columns:1.5fr 1fr; gap:42px; padding:32px; }
.result-label { font-size:10px; text-transform:uppercase; letter-spacing:.08em; color:var(--svc-accent); }
.porting-approach h3 { font-size:24px; line-height:1.3; letter-spacing:-.025em; margin:12px 0 16px; }
.porting-approach p { font-size:13px; line-height:1.85; color:var(--color-muted-foreground); margin-bottom:20px; }
.porting-approach ul { padding:0; list-style:none; margin:0; display:grid; gap:12px; }
.porting-approach li { display:flex; gap:10px; font-size:12px; line-height:1.6; }
.porting-approach li span { color:var(--color-green); }
.porting-brief { padding:24px; border:1px solid var(--color-border); border-radius:14px; background:var(--color-card); align-self:start; }
.brief-icon { display:block; color:var(--svc-accent); font:600 21px ui-monospace,monospace; margin-bottom:14px; }
.porting-brief h4 { font-size:13px; margin:0 0 12px; }
.porting-brief p { font-size:12px; line-height:1.8; color:var(--color-muted-foreground); margin-bottom:22px; }
.porting-brief a { font-size:12px; }
.porting-note { color:var(--color-muted-foreground); font-size:12px; line-height:1.8; margin:18px 0 0; }
.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
@media(max-width:760px) { .porting-choices { grid-template-columns:repeat(2,minmax(0,1fr)); } .porting-detail { grid-template-columns:1fr; gap:24px; padding:24px; } .porting-brief { display:grid; grid-template-columns:1fr; } .porting-route { padding:24px; grid-template-columns:1fr 24px 1fr 24px 1fr; } .porting-route strong { font-size:12px; } .choice-body { padding:12px; } }
@media(max-width:480px) { .porting-selector { padding:30px 0 44px; } .porting-form { padding:18px; } .porting-choices { gap:9px; } .choice-body { padding:12px 10px; gap:8px; min-height:68px; font-size:11px; } .choice-mark { width:26px; height:30px; font-size:12px; border-radius:7px; } .choice-check { font-size:10px; } .porting-route { grid-template-columns:1fr; gap:12px; padding:20px; } .porting-route>div { gap:4px; } .route-arrow { text-align:left; transform:rotate(90deg); width:18px; font-size:18px; } .porting-route small { display:none; } .porting-route strong { font-size:13px; } .porting-detail { padding:20px; } .porting-approach h3 { font-size:22px; } .porting-brief { padding:20px; } }
@media(prefers-reduced-motion:reduce) { .choice-body { transition:none; } }
</style>
