---
import { Locale } from '../../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
interface Props { leadership?: boolean; }
const { leadership = false } = Astro.props;
const projects = [
 { slug: 'ai-defender', title: 'AI Defender', label: t("In development · wave defense"), image: '/assets/games/ai-defender/screens/land/battle49-swarm.webp', alt: t("Landscape gameplay in AI Defender") },
 { slug: 'idle-submarine', title: 'Idle Submarine', label: t("In development · responsive UI"), image: '/assets/games/idle-submarine/cover.webp', alt: t("A submarine and treasure in Idle Submarine") },
 { slug: 'rings', title: 'Rings', label: t("In development · spatial puzzle"), image: '/assets/games/rings/cover.webp', alt: t("Interlinked metal rings in Rings") },
];
---
<section class="svc-proof" aria-labelledby="proof-heading">
 <div class="svc-section-heading"><div><span class="svc-eyebrow">{t("Practical experience")}</span><h2 id="proof-heading">{leadership ? t("Explore my experience") : t("Original games and tools")}</h2></div><a class="svc-text-link" href={i18n.path('/games/')}>{t("View portfolio")} <span aria-hidden="true">↗</span></a></div>
 {leadership ? <div class="lead-proof"><div class="lead-proof-main"><span>Moon Active</span><h3>{t("Built and led an HTML5 playable ads department")}</h3><p>{t("A shared engine, development tools and production workflow. Technical leadership with hands-on engineering.")}</p></div><div class="lead-proof-links"><a href={i18n.path('/academy/sdk/')}><b>GameDevLand SDK <span aria-hidden="true">↗</span></b><span>{t("My own technology and a course on its API")}</span></a><a href={i18n.path('/about/')}><b>{t("About me")} <span aria-hidden="true">↗</span></b><span>{t("Specialization and technical approach")}</span></a><a href={i18n.path('/games/')}><b>{t("Games")} <span aria-hidden="true">↗</span></b><span>{t("Playable builds and work descriptions")}</span></a></div></div> : <>
 <div class="svc-projects">{projects.map(project => <a class="svc-project" href={i18n.path(`/games/${project.slug}/`)}><div class="project-image"><img src={project.image} alt={project.alt} loading="lazy" width="640" height="360"/><span class="project-open" aria-hidden="true">↗</span></div><div class="project-caption"><h3>{project.title}</h3><p>{project.label}</p></div></a>)}</div>
 <div class="svc-tool-note"><span class="tool-symbol" aria-hidden="true">&lt;/&gt;</span><div><b>{t("My own SDK and build tools")}</b><p>{t("I use them to develop games and adapt them for platforms. The integration approach depends on the project.")}</p></div><a class="svc-text-link" href={i18n.path('/academy/sdk/')}>{t("About the SDK")} <span aria-hidden="true">↗</span></a></div>
 </>}
</section>
