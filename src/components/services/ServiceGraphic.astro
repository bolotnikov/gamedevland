---
import { Locale } from '../../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
import type { ServiceGraphic, ServiceShowcase } from '../../data/services';
interface Props { kind: ServiceGraphic | 'overview'; showcase?: ServiceShowcase | undefined; }
const { kind, showcase } = Astro.props;
---
<figure class:list={['service-graphic', `graphic--${kind}`]}>
 {kind === 'overview' && showcase && <>
  <div class="overview-art">
   <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
   <div class="browser overview-browser"><div class="browser-bar"><i></i><i></i><i></i><span>GameDev.Land / HTML5</span></div><img src={showcase.landscape} alt={showcase.landscapeAlt} width={showcase.landscapeWidth} height={showcase.landscapeHeight} fetchpriority="high"/></div>
   <div class="phone overview-phone"><img src={showcase.portrait} alt={showcase.portraitAlt} width={showcase.portraitWidth} height={showcase.portraitHeight}/></div>
   <div class="floating-label label-code"><b>&lt;/&gt;</b><span>{t("Idea → HTML5")}</span></div>
   <div class="floating-label label-publish"><span class="status-dot"></span><span>{t("Adaptation → release")}</span></div>
  </div>
  <figcaption>{showcase.caption}</figcaption>
 </>}
 {showcase && kind !== 'overview' && <>
  <div class="game-art">
   <span class="art-kicker">{t("One project · different screens")}</span>
   <div class="browser game-browser">
    <div class="browser-bar"><i></i><i></i><i></i><span>{showcase.title}</span></div>
    <img src={showcase.landscape} alt={showcase.landscapeAlt} width={showcase.landscapeWidth} height={showcase.landscapeHeight} fetchpriority="high"/>
   </div>
   <div class="phone game-phone"><img src={showcase.portrait} alt={showcase.portraitAlt} width={showcase.portraitWidth} height={showcase.portraitHeight}/></div>
   <span class="game-art-label">{t("Mouse + touch")}</span>
  </div>
  <figcaption>{showcase.caption}</figcaption>
 </>}
 {kind === 'port' && <>
  <div class="port-art">
   <span class="art-kicker">{t("From an existing project to a web version")}</span>
   <div class="source-project"><span class="source-mark">→</span><div><b>{t("Unity · Flash")}</b><span>{t("Logic · scenes · assets")}</span></div></div>
   <div class="transfer"><span></span><b>{t("Review → port → adapt")}</b><span></span></div>
   <div class="browser port-browser"><div class="browser-bar"><i></i><i></i><i></i><span>{t("HTML5 / browser")}</span></div><div class="web-output"><span class="web-mark">&lt;/&gt;</span><div><b>{t("Web version of the game")}</b><span>{t("Controls · UI · SDK")}</span></div></div></div>
   <div class="output-devices"><span>{t("Desktop")}</span><span>{t("Mobile")}</span><span>{t("Площадки")}</span></div>
  </div>
  <figcaption>{t("Porting overview · technical approach chosen after review")}</figcaption>
 </>}
 {kind === 'lead' && <>
  <div class="lead-art">
   <span class="art-kicker">{t("Technical leadership")}</span>
   <div class="lead-person"><img src="/ava2.jpg" alt={t("Alexander Bolotnikov")} width="100" height="100"/><div><b>{t("Alexander Bolotnikov")}</b><span>Tech Lead · HTML5</span></div></div>
   <div class="lead-branches"><div><span>01</span><b>{t("Team")}</b><small>{t("Reviews and growth")}</small></div><div><span>02</span><b>{t("Architecture")}</b><small>{t("Decisions and tools")}</small></div></div>
   <div class="lead-delivery"><span class="status-dot"></span><b>{t("Develop → test → release")}</b></div>
  </div>
  <figcaption>{t("Responsibility for people, technology and process")}</figcaption>
 </>}
</figure>
<style>
.service-graphic {
	margin:0;
	min-width:0;
	--art-accent:var(--color-cyan)
}

.graphic--playable {
	--art-accent:var(--color-violet)
}

.service-graphic>div {
	position:relative;
	min-height:390px;
	border:1px solid var(--color-border);
	border-radius:24px;
	background:radial-gradient(ellipse at 80% 15%,color-mix(in srgb,var(--art-accent) 12%,transparent),transparent 65%),var(--color-card);
	overflow:hidden
}

.service-graphic figcaption {
	color:var(--color-muted-foreground);
	font-size:11px;
	line-height:1.6;
	margin:14px 8px 0;
	text-align:center
}

.browser {
	overflow:hidden;
	border:1px solid var(--color-line);
	border-radius:13px;
	background:var(--color-card);
	box-shadow:0 24px 45px #020a231f
}

.browser-bar {
	height:30px;
	display:flex;
	align-items:center;
	gap:5px;
	padding:0 10px;
	background:var(--color-secondary);
	color:var(--color-muted-foreground)
}

.browser-bar i {
	height:5px;
	width:5px;
	border-radius:50%;
	background:var(--color-line)
}

.browser-bar span {
	margin-left:auto;
	margin-right:auto;
	font-size:9px
}

.browser img {
	width:100%;
	height:auto
}

.phone {
	position:absolute;
	overflow:hidden;
	border:5px solid #142238;
	border-radius:22px;
	box-shadow:0 20px 32px #020a2345;
	background:#142238
}

.phone img {
	width:100%;
	height:auto
}

.art-orbit {
	position:absolute;
	border:1px dashed color-mix(in srgb,var(--color-cyan) 25%,transparent);
	border-radius:50%;
	width:440px;
	height:440px;
	top:-10px;
	left:30px
}

.orbit-two {
	width:300px;
	height:300px;
	top:60px;
	left:100px
}

.overview-browser {
	position:absolute;
	top:75px;
	left:7%;
	width:78%;
	transform:rotate(-5deg)
}

.overview-phone {
	width:27%;
	right:5%;
	top:100px;
	transform:rotate(9deg)
}

.floating-label {
	position:absolute;
	display:flex;
	align-items:center;
	gap:10px;
	padding:13px 16px;
	border:1px solid var(--color-border);
	border-radius:11px;
	background:var(--color-card);
	box-shadow:var(--shadow-card);
	font-size:12px
}

.label-code {
	top:28px;
	left:8%;
	transform:rotate(-4deg)
}

.label-code b {
	color:var(--color-cyan);
	font-size:20px
}

.label-publish {
	bottom:26px;
	left:15%;
	transform:rotate(-2deg)
}

.status-dot {
	display:inline-block;
	width:7px;
	height:7px;
	flex-shrink:0;
	background:var(--color-green);
	border-radius:50%;
	box-shadow:0 0 0 4px color-mix(in srgb,var(--color-green) 10%,transparent)
}

.art-kicker {
	display:block;
	font-size:11px;
	line-height:1.5;
	color:var(--color-muted-foreground);
	margin-bottom:25px
}

.game-art {
	padding:28px
}

.game-browser {
	position:absolute;
	top:100px;
	left:6%;
	width:78%;
	transform:rotate(-3deg)
}

.game-phone {
	width:25%;
	right:6%;
	top:78px;
	transform:rotate(5deg)
}

.game-art-label {
	position:absolute;
	z-index:2;
	bottom:18px;
	left:22px;
	padding:7px 10px;
	border:1px solid var(--color-border);
	border-radius:7px;
	background:var(--color-card);
	color:var(--color-cyan);
	font-size:12px
}















.port-art {
	padding:28px
}

.source-project {
	display:flex;
	align-items:center;
	gap:16px;
	padding:20px;
	border:1px solid var(--color-border);
	border-radius:12px;
	background:var(--color-background)
}

.source-mark {
	display:grid;
	place-items:center;
	font-size:24px;
	width:54px;
	height:54px;
	border-radius:10px;
	background:color-mix(in srgb,var(--color-violet) 12%,var(--color-card));
	color:var(--color-violet)
}

.source-project b,.web-output b {
	font-size:14px;
	display:block
}

.source-project div>span,.web-output div>span {
	font-size:11px;
	color:var(--color-muted-foreground);
	display:block;
	margin-top:7px
}

.transfer {
	display:flex;
	flex-direction:column;
	align-items:center;
	gap:6px;
	margin:8px 0;
	color:var(--color-cyan)
}

.transfer span {
	height:10px;
	width:1px;
	background:var(--color-cyan)
}

.transfer span:last-child:after {
	content:'↓';
	position:relative;
	top:-5px;
	left:-4px
}

.transfer b {
	font-size:10px;
	font-weight:500
}

.web-output {
	padding:20px;
	display:flex;
	align-items:center;
	gap:16px
}

.web-mark {
	font-size:24px;
	color:var(--color-cyan)
}

.output-devices {
	display:flex;
	justify-content:center;
	gap:22px;
	font-size:10px;
	color:var(--color-muted-foreground);
	margin-top:16px
}

.lead-art {
	padding:28px;
	--art-accent:var(--color-violet)
}

.lead-person {
	display:flex;
	align-items:center;
	gap:18px;
	padding:10px 0 28px;
	position:relative
}

.lead-person img {
	width:70px;
	height:70px;
	object-fit:cover;
	border-radius:50%;
	border:3px solid var(--color-card);
	box-shadow:0 0 0 1px var(--color-border)
}

.lead-person b {
	display:block;
	font-size:15px
}

.lead-person div>span {
	display:block;
	font-size:11px;
	color:var(--color-violet);
	margin-top:8px
}

.lead-branches {
	display:grid;
	grid-template-columns:1fr 1fr;
	gap:18px;
	border-top:1px solid var(--color-line);
	padding-top:20px
}

.lead-branches>div {
	padding:17px;
	border:1px solid var(--color-border);
	border-radius:10px;
	background:var(--color-background)
}

.lead-branches span {
	display:block;
	font-size:10px;
	color:var(--color-violet);
	margin-bottom:15px
}

.lead-branches b {
	display:block;
	font-size:14px
}

.lead-branches small {
	display:block;
	font-size:10px;
	line-height:1.5;
	color:var(--color-muted-foreground);
	margin-top:8px
}

.lead-delivery {
	display:flex;
	align-items:center;
	justify-content:center;
	gap:12px;
	margin-top:25px
}

.lead-delivery b {
	font-size:11px;
	font-weight:500
}

@media(min-width:1100px) {
	.overview-art {
		min-height:440px!important
	}
	.overview-browser {
		top:95px
	}
	.overview-phone {
		top:110px
	}
	.label-publish {
		bottom:35px
	}
}

@media(max-width:600px) {

	.service-graphic>div {
		min-height:350px;
		border-radius:18px
	}
	.overview-browser {
		top:85px
	}
	.overview-phone {
		top:90px
	}
	.game-browser {
		top:110px
	}
	.game-phone {
		top:100px
	}
	.port-art,.lead-art,.game-art {
		padding:22px
	}
	.lead-person b {
		font-size:13px
	}
	.lead-branches {
		gap:12px
	}
	.lead-branches>div {
		padding:13px
	}
	.lead-branches b {
		font-size:13px
	}
}
</style>
