---
import { Locale } from '../../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
import type { ServiceGraphic } from '../../data/services';
import FlashPortScene from './FlashPortScene.astro';
interface Props { kind: ServiceGraphic | 'overview'; }
const { kind } = Astro.props;
const platforms = ['CrazyGames', 'GameDistribution', 'Playgama', t("Yandex Games"), 'Poki'];
const showcase = kind === 'games' ? {
 title: 'AI Defender',
 landscape: '/assets/games/ai-defender/screens/land/battle.webp',
 landscapeWidth: 1920, landscapeHeight: 1080,
 portrait: '/assets/games/ai-defender/screens/port/battle.webp',
 portraitWidth: 1080, portraitHeight: 1920,
 landscapeAlt: t('Landscape gameplay in AI Defender'),
 portraitAlt: t('Portrait gameplay in AI Defender'),
 caption: t('AI Defender — an original project in development'),
} : kind === 'playable' ? {
 title: 'Idle Submarine',
 landscape: '/assets/games/idle-submarine/cover.webp',
 landscapeWidth: 1536, landscapeHeight: 1024,
 portrait: '/assets/games/idle-submarine/screens/port/gameplay.webp',
 portraitWidth: 390, portraitHeight: 844,
 landscapeAlt: t('Landscape version of Idle Submarine'),
 portraitAlt: t('Portrait gameplay in Idle Submarine'),
 caption: t('Idle Submarine — an original project in development'),
} : undefined;
---
<figure class:list={['service-graphic', `graphic--${kind}`]}>
 {kind === 'overview' && <>
  <div class="overview-art">
   <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
   <div class="browser overview-browser"><div class="browser-bar"><i></i><i></i><i></i><span>GameDev.Land / HTML5</span></div><img src="/assets/games/idle-submarine/cover.webp" alt={t("An Idle Submarine gameplay scene with a yellow submarine")} width="960" height="540" fetchpriority="high"/></div>
   <div class="phone overview-phone"><img src="/assets/games/rings/screens/port/gameplay.webp" alt={t("Portrait version of Rings")} width="540" height="960"/></div>
   <div class="floating-label label-code"><b>&lt;/&gt;</b><span>{t("Idea → HTML5")}</span></div>
   <div class="floating-label label-publish"><span class="status-dot"></span><span>{t("Adaptation → release")}</span></div>
  </div>
  <figcaption>{t("Original games: Idle Submarine and Rings · in development")}</figcaption>
 </>}
 {showcase && <>
  <div class="game-art">
   <span class="art-kicker">{t("One project · different screens")}</span>
   <div class="browser game-browser">
    <div class="browser-bar"><i></i><i></i><i></i><span>{showcase.title}</span></div>
    <img src={showcase.landscape} alt={showcase.landscapeAlt} width={showcase.landscapeWidth} height={showcase.landscapeHeight} fetchpriority="high"/>
   </div>
   <div class="phone game-phone"><img src={showcase.portrait} alt={showcase.portraitAlt} width={showcase.portraitWidth} height={showcase.portraitHeight}/></div>
   <span class="game-art-label">{t("Mouse + touch")}</span>
  </div>
  <figcaption>{showcase.caption}</figcaption>
 </>}
 {kind === 'port' && <>
  <div class="port-art">
   <span class="art-kicker">{t("From an existing project to a web version")}</span>
   <div class="source-project"><span class="source-mark">C#</span><div><b>{t("Unity / another engine")}</b><span>{t("Logic · scenes · assets")}</span></div></div>
   <div class="transfer"><span></span><b>{t("Review → port → adapt")}</b><span></span></div>
   <div class="browser port-browser"><div class="browser-bar"><i></i><i></i><i></i><span>{t("HTML5 / browser")}</span></div><div class="web-output"><span class="web-mark">&lt;/&gt;</span><div><b>{t("Web version of the game")}</b><span>{t("Controls · UI · SDK")}</span></div></div></div>
   <div class="output-devices"><span>{t("Desktop")}</span><span>{t("Mobile")}</span><span>{t("Площадки")}</span></div>
  </div>
  <figcaption>{t("Porting overview · technical approach chosen after review")}</figcaption>
 </>}
 {kind === 'flash' && <>
  <div class="flash-art">
   <span class="art-kicker">{t("Same game, a new platform")}</span>
   <div class="flash-compare">
    <div class="flash-before">
     <span class="flash-version-label">{t("Before / Flash")}</span>
     <div class="flash-editor">
      <div class="flash-editor-bar"><span class="flash-file-icon" aria-hidden="true">f</span><span>game.fla</span><span class="flash-window-controls" aria-hidden="true">− ×</span></div>
      <FlashPortScene/>
      <div class="flash-timeline" aria-hidden="true"><span></span>{Array.from({length: 8}, (_, i) => <i class:list={[i === 3 && 'is-current']}></i>)}</div>
     </div>
     <span class="flash-device-label">{t("Keyboard")}</span>
    </div>
    <span class="flash-transfer-arrow" aria-hidden="true">→</span>
    <div class="flash-after">
     <span class="flash-version-label">{t("After / HTML5")}</span>
     <div class="flash-phone"><span class="flash-phone-camera" aria-hidden="true"></span><FlashPortScene touch/></div>
     <span class="flash-device-label">{t("Mouse + touch")}</span>
    </div>
   </div>
  </div>
  <figcaption>{t("Illustrative porting example, not a client case study")}</figcaption>
 </>}
 {kind === 'publishing' && <>
  <div class="publishing-art">
   <span class="art-kicker">{t("Preparation for each platform")}</span>
   <div class="publish-source"><span>&lt;/&gt;</span><div><b>{t("HTML5 game")}</b><small>{t("Existing project")}</small></div></div>
   <div class="publish-bridge"><span>{t("Adaptation")}</span><span>SDK</span><span>{t("Builds")}</span></div>
   <div class="publish-outputs">{platforms.map((name, index) => <div><span class="platform-mark">{['C', 'GD', 'P', t("Y"), 'p'][index]}</span><b>{name}</b></div>)}</div>
  </div>
  <figcaption>{t("Target platforms · selection and terms agreed for each game")}</figcaption>
 </>}
 {kind === 'lead' && <>
  <div class="lead-art">
   <span class="art-kicker">{t("Technical leadership")}</span>
   <div class="lead-person"><img src="/ava2.jpg" alt={t("Alexander Bolotnikov")} width="100" height="100"/><div><b>{t("Alexander Bolotnikov")}</b><span>Tech Lead · HTML5</span></div></div>
   <div class="lead-branches"><div><span>01</span><b>{t("Team")}</b><small>{t("Reviews and growth")}</small></div><div><span>02</span><b>{t("Architecture")}</b><small>{t("Decisions and tools")}</small></div></div>
   <div class="lead-delivery"><span class="status-dot"></span><b>{t("Develop → test → release")}</b></div>
  </div>
  <figcaption>{t("Responsibility for people, technology and process")}</figcaption>
 </>}
</figure>
<style>
.service-graphic {
	margin:0;
	min-width:0;
	--art-accent:var(--color-cyan)
}

.graphic--playable {
	--art-accent:var(--color-violet)
}

.service-graphic>div {
	position:relative;
	min-height:390px;
	border:1px solid var(--color-border);
	border-radius:24px;
	background:radial-gradient(ellipse at 80% 15%,color-mix(in srgb,var(--art-accent) 12%,transparent),transparent 65%),var(--color-card);
	overflow:hidden
}

.service-graphic figcaption {
	color:var(--color-muted-foreground);
	font-size:11px;
	line-height:1.6;
	margin:14px 8px 0;
	text-align:center
}

.browser {
	overflow:hidden;
	border:1px solid var(--color-line);
	border-radius:13px;
	background:var(--color-card);
	box-shadow:0 24px 45px #020a231f
}

.browser-bar {
	height:30px;
	display:flex;
	align-items:center;
	gap:5px;
	padding:0 10px;
	background:var(--color-secondary);
	color:var(--color-muted-foreground)
}

.browser-bar i {
	height:5px;
	width:5px;
	border-radius:50%;
	background:var(--color-line)
}

.browser-bar span {
	margin-left:auto;
	margin-right:auto;
	font-size:9px
}

.browser img {
	width:100%;
	height:auto
}

.phone {
	position:absolute;
	overflow:hidden;
	border:5px solid #142238;
	border-radius:22px;
	box-shadow:0 20px 32px #020a2345;
	background:#142238
}

.phone img {
	width:100%;
	height:auto
}

.art-orbit {
	position:absolute;
	border:1px dashed color-mix(in srgb,var(--color-cyan) 25%,transparent);
	border-radius:50%;
	width:440px;
	height:440px;
	top:-10px;
	left:30px
}

.orbit-two {
	width:300px;
	height:300px;
	top:60px;
	left:100px
}

.overview-browser {
	position:absolute;
	top:75px;
	left:7%;
	width:78%;
	transform:rotate(-5deg)
}

.overview-phone {
	width:27%;
	right:5%;
	top:100px;
	transform:rotate(9deg)
}

.floating-label {
	position:absolute;
	display:flex;
	align-items:center;
	gap:10px;
	padding:13px 16px;
	border:1px solid var(--color-border);
	border-radius:11px;
	background:var(--color-card);
	box-shadow:var(--shadow-card);
	font-size:12px
}

.label-code {
	top:28px;
	left:8%;
	transform:rotate(-4deg)
}

.label-code b {
	color:var(--color-cyan);
	font-size:20px
}

.label-publish {
	bottom:26px;
	left:15%;
	transform:rotate(-2deg)
}

.status-dot {
	display:inline-block;
	width:7px;
	height:7px;
	flex-shrink:0;
	background:var(--color-green);
	border-radius:50%;
	box-shadow:0 0 0 4px color-mix(in srgb,var(--color-green) 10%,transparent)
}

.art-kicker {
	display:block;
	font-size:11px;
	line-height:1.5;
	color:var(--color-muted-foreground);
	margin-bottom:25px
}

.game-art {
	padding:28px
}

.game-browser {
	position:absolute;
	top:100px;
	left:6%;
	width:78%;
	transform:rotate(-3deg)
}

.game-phone {
	width:25%;
	right:6%;
	top:78px;
	transform:rotate(5deg)
}

.game-art-label {
	position:absolute;
	z-index:2;
	bottom:18px;
	left:22px;
	padding:7px 10px;
	border:1px solid var(--color-border);
	border-radius:7px;
	background:var(--color-card);
	color:var(--color-cyan);
	font-size:12px
}















.port-art {
	padding:28px
}

.source-project {
	display:flex;
	align-items:center;
	gap:16px;
	padding:20px;
	border:1px solid var(--color-border);
	border-radius:12px;
	background:var(--color-background)
}

.source-mark {
	display:grid;
	place-items:center;
	font-size:24px;
	width:54px;
	height:54px;
	border-radius:10px;
	background:color-mix(in srgb,var(--color-violet) 12%,var(--color-card));
	color:var(--color-violet)
}

.source-project b,.web-output b {
	font-size:14px;
	display:block
}

.source-project div>span,.web-output div>span {
	font-size:11px;
	color:var(--color-muted-foreground);
	display:block;
	margin-top:7px
}

.transfer {
	display:flex;
	flex-direction:column;
	align-items:center;
	gap:6px;
	margin:8px 0;
	color:var(--color-cyan)
}

.transfer span {
	height:10px;
	width:1px;
	background:var(--color-cyan)
}

.transfer span:last-child:after {
	content:'↓';
	position:relative;
	top:-5px;
	left:-4px
}

.transfer b {
	font-size:10px;
	font-weight:500
}

.web-output {
	padding:20px;
	display:flex;
	align-items:center;
	gap:16px
}

.web-mark {
	font-size:24px;
	color:var(--color-cyan)
}

.output-devices {
	display:flex;
	justify-content:center;
	gap:22px;
	font-size:10px;
	color:var(--color-muted-foreground);
	margin-top:16px
}

.flash-art {
 padding:28px;
 --art-accent:var(--color-amber)
}
.flash-compare {
 display:grid;
 grid-template-columns:minmax(0,1.3fr) 28px minmax(0,1fr);
 align-items:center;
 gap:14px;
 margin-top:22px
}
.flash-version-label {
 display:block;
 margin-bottom:14px;
 color:var(--color-foreground);
 font-size:12px;
 font-weight:500
}
.flash-before,.flash-after { min-width:0; }
.flash-after { text-align:center; }
.flash-editor {
 overflow:hidden;
 border:1px solid var(--color-line);
 border-radius:6px;
 background:var(--color-secondary);
 box-shadow:0 14px 30px #020a2320;
 transform:rotate(-2deg)
}
.flash-editor-bar {
 display:flex;
 align-items:center;
 gap:7px;
 height:27px;
 padding:0 8px;
 color:var(--color-muted-foreground);
 font:10px/1.5 monospace
}
.flash-file-icon {
 display:grid;
 place-items:center;
 width:15px;
 height:16px;
 border-radius:2px;
 background:#b7463f;
 color:#fff;
 font:italic 600 14px/1 serif
}
.flash-window-controls { margin-left:auto; font-size:11px; }
.flash-timeline {
 display:flex;
 align-items:center;
 gap:3px;
 height:32px;
 padding:7px 8px;
 border-top:1px solid var(--color-border)
}
.flash-timeline>span { width:20%; height:4px; margin-right:4px; background:var(--color-line); }
.flash-timeline i { flex:1; height:15px; border:1px solid var(--color-line); background:var(--color-card); }
.flash-timeline i.is-current { border-color:var(--color-amber); background:color-mix(in srgb,var(--color-amber) 35%,var(--color-card)); }
.flash-phone {
 position:relative;
 max-width:137px;
 margin-inline:auto;
 padding:5px;
 border:1px solid var(--color-line);
 border-radius:20px;
 background:#142238;
 box-shadow:0 16px 30px #020a2330;
 transform:rotate(3deg)
}
.flash-phone-camera { position:absolute; z-index:2; top:10px; left:calc(50% - 13px); width:26px; height:5px; border-radius:5px; background:#142238; }
.flash-device-label { display:block; margin-top:15px; color:var(--color-muted-foreground); font-size:11px; }
.flash-transfer-arrow { color:var(--color-amber); font-size:28px; text-align:center; }

.publishing-art {
	padding:28px
}

.publish-source {
	margin:0 auto;
	max-width:225px;
	display:flex;
	gap:15px;
	align-items:center;
	border:1px solid var(--color-cyan);
	border-radius:12px;
	padding:17px;
	background:var(--color-background)
}

.publish-source>span {
	font-size:28px;
	color:var(--color-cyan)
}

.publish-source b {
	font-size:15px
}

.publish-source small {
	display:block;
	font-size:10px;
	color:var(--color-muted-foreground);
	margin-top:5px
}

.publish-bridge {
	position:relative;
	display:flex;
	justify-content:center;
	gap:8px;
	margin:27px 0;
	padding:12px 0;
	border-top:1px solid var(--color-line);
	border-bottom:1px solid var(--color-line)
}

.publish-bridge:before,.publish-bridge:after {
	content:'';
	width:1px;
	height:28px;
	background:var(--color-line);
	position:absolute;
	left:50%;
	top:-28px
}

.publish-bridge:after {
	top:auto;
	bottom:-28px
}

.publish-bridge span {
	padding:6px 10px;
	font-size:10px;
	background:var(--color-secondary);
	border-radius:5px
}

.publish-outputs {
	display:grid;
	grid-template-columns:repeat(6,1fr);
	gap:10px;
	position:relative
}

.publish-outputs>div {
	grid-column:span 2;
	display:flex;
	align-items:center;
	gap:7px;
	padding:12px 8px;
	border:1px solid var(--color-border);
	border-radius:8px;
	background:var(--color-card);
	z-index:1
}

.publish-outputs>div:nth-child(4) {
	grid-column:2/span 2
}

.publish-outputs b {
	font-size:11px;
	font-weight:500
}

.platform-mark {
	font-size:11px;
	display:grid;
	place-items:center;
	width:25px;
	height:25px;
	flex-shrink:0;
	background:var(--color-secondary);
	border-radius:6px;
	color:var(--color-cyan)
}

.lead-art {
	padding:28px;
	--art-accent:var(--color-violet)
}

.lead-person {
	display:flex;
	align-items:center;
	gap:18px;
	padding:10px 0 28px;
	position:relative
}

.lead-person img {
	width:70px;
	height:70px;
	object-fit:cover;
	border-radius:50%;
	border:3px solid var(--color-card);
	box-shadow:0 0 0 1px var(--color-border)
}

.lead-person b {
	display:block;
	font-size:15px
}

.lead-person div>span {
	display:block;
	font-size:11px;
	color:var(--color-violet);
	margin-top:8px
}

.lead-branches {
	display:grid;
	grid-template-columns:1fr 1fr;
	gap:18px;
	border-top:1px solid var(--color-line);
	padding-top:20px
}

.lead-branches>div {
	padding:17px;
	border:1px solid var(--color-border);
	border-radius:10px;
	background:var(--color-background)
}

.lead-branches span {
	display:block;
	font-size:10px;
	color:var(--color-violet);
	margin-bottom:15px
}

.lead-branches b {
	display:block;
	font-size:14px
}

.lead-branches small {
	display:block;
	font-size:10px;
	line-height:1.5;
	color:var(--color-muted-foreground);
	margin-top:8px
}

.lead-delivery {
	display:flex;
	align-items:center;
	justify-content:center;
	gap:12px;
	margin-top:25px
}

.lead-delivery b {
	font-size:11px;
	font-weight:500
}

@media(min-width:1100px) {
	.overview-art {
		min-height:440px!important
	}
	.overview-browser {
		top:95px
	}
	.overview-phone {
		top:110px
	}
	.label-publish {
		bottom:35px
	}
}

@media(max-width:600px) {
 .flash-compare { grid-template-columns:minmax(0,1.3fr) 22px minmax(0,1fr); gap:10px; margin-top:24px; }
 .flash-version-label { font-size:11px; }
 .flash-device-label { font-size:10px; }
 .flash-editor-bar { gap:5px; padding-inline:6px; font-size:9px; }
 .flash-transfer-arrow { font-size:23px; }

	.service-graphic>div {
		min-height:350px;
		border-radius:18px
	}
	.overview-browser {
		top:85px
	}
	.overview-phone {
		top:90px
	}
	.game-browser {
		top:110px
	}
	.game-phone {
		top:100px
	}
	.port-art,.flash-art,.publishing-art,.lead-art,.game-art {
		padding:22px
	}
	.publish-outputs {
		grid-template-columns:repeat(2,minmax(0,1fr));
		gap:8px
	}
	.publish-outputs>div {
		grid-column:auto;
		flex-direction:column;
		padding:12px 5px;
		gap:7px
	}
	.publish-outputs>div:nth-child(4) {
		grid-column:auto
	}
	.publish-outputs>div:last-child {
		grid-column:1/-1;
		flex-direction:row;
		justify-content:center
	}
	.publish-outputs b {
		font-size:11px
	}
	.platform-mark {
		width:24px;
		height:24px;
		font-size:11px
	}
	.lead-person b {
		font-size:13px
	}
	.lead-branches {
		gap:12px
	}
	.lead-branches>div {
		padding:13px
	}
	.lead-branches b {
		font-size:13px
	}
}
</style>
