---
import { Locale } from '../../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
const contributions = [
 { title: 'Core engine, SDK and shared modules', text: 'I build and evolve reusable game systems so the team can use a shared technical foundation across projects.' },
 { title: 'Interviewing and mentoring', text: 'Technical interviews, onboarding, code reviews and support for developers as they grow more independent.' },
 { title: 'R&D and emerging technologies', text: 'I test new tools through focused prototypes and assess their limitations before bringing them into production.' },
 { title: 'Reliability and accountability', text: 'Clear acceptance criteria, visible risks and agreed responsibilities. I take ownership of technical decisions, validation and delivery of the agreed work.' },
];
---
<section class="lead-value" aria-labelledby="lead-value-title">
 <div class="svc-section-heading"><h2 id="lead-value-title">{t('What I can bring to the team')}</h2></div>
 <div class="lead-value-grid">
  {contributions.map(item => <article><h3>{t(item.title)}</h3><p>{t(item.text)}</p></article>)}
 </div>
</section>
<section class="lead-ai" aria-labelledby="lead-ai-title">
 <div class="lead-ai-practice">
  <h2 id="lead-ai-title">{t('AI-assisted development')}</h2>
  <p>{t('I built asset optimization pipelines, analytics systems and build automation, and introduced AI-assisted workflows for code generation, asset processing and testing.')}</p>
  <p>{t('Generated code and processed assets go through review and validation before becoming part of the project.')}</p>
 </div>
 <article class="lead-ai-sdk">
  <span class="lead-sdk-mark" aria-hidden="true">&lt;/&gt;</span>
  <h3>GameDevLand SDK</h3>
  <p>{t('I created GameDevLand SDK, an open-source framework for HTML5 games. Clear module boundaries, reusable components and documented APIs give AI agents a consistent structure to work within and help keep the code readable and maintainable.')}</p>
  <p>{t('I share the engineering decisions behind the SDK and my games through technical articles and practical examples.')}</p>
  <div class="lead-ai-links">
   <a class="svc-text-link" href="https://github.com/gamedevland/sdk" target="_blank" rel="noopener noreferrer">{t('SDK on GitHub')} <span aria-hidden="true">↗</span></a>
   <a class="svc-text-link" href={i18n.path('/articles/ai-assisted-game-development/')}>{t('Articles and examples')} <span aria-hidden="true">↗</span></a>
  </div>
 </article>
</section>
<style>
.lead-value { margin-bottom: 55px; }
.lead-value-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 48px; }
.lead-value-grid article { min-width: 0; padding-top: 20px; border-top: 1px solid var(--color-border); }
.lead-value h3 { margin-bottom: 10px; font-size: 18px; line-height: 1.4; letter-spacing: -.02em; }
.lead-value p, .lead-ai p { margin-bottom: 0; color: var(--color-muted-foreground); font-size: 13px; line-height: 1.85; }
.lead-ai { display: grid; grid-template-columns: 1fr 1.15fr; gap: 38px; padding: 34px; margin-bottom: 70px; border: 1px solid var(--color-border); border-radius: 18px; background: linear-gradient(120deg, var(--svc-tint), var(--color-card)); }
.lead-ai-practice, .lead-ai-sdk { min-width: 0; }
.lead-ai h2 { margin-bottom: 20px; font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1.25; letter-spacing: -.035em; }
.lead-ai p + p { margin-top: 14px; }
.lead-ai-sdk { padding-left: 32px; border-left: 1px solid var(--color-border); }
.lead-sdk-mark { display: inline-block; margin-bottom: 14px; color: var(--svc-accent); font: 25px/1 monospace; }
.lead-ai h3 { margin-bottom: 13px; font-size: 21px; line-height: 1.3; letter-spacing: -.025em; }
.lead-ai-links { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 22px; }
@media (max-width: 760px) {
 .lead-value-grid { gap: 24px; }
 .lead-value h3 { font-size: 16px; }
 .lead-ai { grid-template-columns: 1fr; gap: 26px; padding: 28px; margin-bottom: 45px; }
 .lead-ai-sdk { padding: 24px 0 0; border-left: 0; border-top: 1px solid var(--color-border); }
}
@media (max-width: 480px) {
 .lead-value { margin-bottom: 38px; }
 .lead-value-grid { grid-template-columns: 1fr; gap: 20px; }
 .lead-ai { padding: 24px; }
 .lead-value p, .lead-ai p { font-size: 12px; }
}
</style>
