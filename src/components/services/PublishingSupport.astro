---
import { Locale } from '../../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
const platforms = [
 { name: 'Poki', mark: 'p', color: '#22b8f0' },
 { name: 'CrazyGames', mark: 'CG', color: '#a78bfa' },
 { name: 'GameDistribution', mark: 'GD', color: '#4f9cf9' },
 { name: 'Playgama', mark: 'P', color: '#f59e42' },
 { name: 'GamePix', mark: 'GP', color: '#2ecda6' },
 { name: 'GameMonetize', mark: 'GM', color: '#e9b949' },
 { name: t('Yandex Games'), mark: t('Y'), color: '#f16c76' },
];
const support = [
 { title: 'Маркетинговые материалы', text: 'Готовим иконки, обложки, скриншоты, трейлеры и описания под требования каждой площадки.' },
 { title: 'Общение с площадками', text: 'Ведём переговоры, подаём игру, сопровождаем модерацию и работаем с замечаниями до выпуска.' },
 { title: 'Маркетинг и SEO', text: 'Оформляем страницы игры, подбираем ключевые слова, готовим локализации и ведём продвижение.' },
];
---
<section class="publishing-reach" id="platforms" aria-labelledby="publishing-support-title">
 <div class="publishing-sdk">
  <div>
   <h2 id="publishing-support-title">{t('Одна игра — любые HTML5-площадки')}</h2>
   <p>{t('Собственный GameDevLand SDK объединяет работу с площадками через единый API. Подключаем рекламу, сохранения и нужные функции, затем собираем версию игры для каждого портала. При необходимости добавляем новую интеграцию.')}</p>
  </div>
  <a class="publishing-sdk-link" href="https://github.com/gamedevland/sdk" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">&lt;/&gt;</span><b>GameDevLand SDK</b><span aria-hidden="true">↗</span></a>
 </div>
 <ul class="publishing-platforms" aria-label={t('Площадки для публикации')}>
  {platforms.map(platform => <li style={`--platform-color: ${platform.color}`}><span class="platform-monogram" aria-hidden="true">{platform.mark}</span><b>{platform.name}</b></li>)}
 </ul>
</section>
<section class="publishing-full-service" aria-labelledby="publishing-full-service-title">
 <div class="publishing-service-heading">
  <h2 id="publishing-full-service-title">{t('Всю подготовку и сопровождение берём на себя')}</h2>
  <p>{t('От интеграции и тестирования до публикации, продвижения и обновлений.')}</p>
 </div>
 <div class="publishing-support-grid">{support.map((item, index) => <article><span class="publishing-service-number" aria-hidden="true">0{index + 1}</span><h3>{t(item.title)}</h3><p>{t(item.text)}</p></article>)}</div>
</section>
<style>
.publishing-reach { margin-bottom: 64px; padding: 34px; border: 1px solid var(--color-border); border-radius: 18px; background: radial-gradient(ellipse at top right, var(--svc-tint), transparent 70%), var(--color-card); }
.publishing-sdk { display: grid; grid-template-columns: 1fr auto; gap: 36px; align-items: center; margin-bottom: 28px; }
.publishing-sdk > div, .publishing-platforms li, .publishing-support-grid article { min-width: 0; }
.publishing-reach h2, .publishing-full-service h2 { margin-bottom: 16px; font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1.25; letter-spacing: -.035em; }
.publishing-reach p, .publishing-full-service p { margin-bottom: 0; color: var(--color-muted-foreground); font-size: 13px; line-height: 1.85; }
.publishing-sdk-link { display: flex; align-items: center; gap: 12px; padding: 15px 0; color: var(--color-foreground); font-size: 12px; text-decoration: none; white-space: nowrap; }
.publishing-sdk-link > span { color: var(--svc-accent); font: 22px/1 monospace; }
.publishing-sdk-link:hover b { text-decoration: underline; text-underline-offset: 4px; }
.publishing-platforms { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin: 0; padding: 0; list-style: none; }
.publishing-platforms li { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; padding: 22px 18px; border: 1px solid color-mix(in srgb, var(--platform-color) 38%, var(--color-border)); border-radius: 12px; background: linear-gradient(135deg, color-mix(in srgb, var(--platform-color) 13%, transparent), transparent), var(--color-card); box-shadow: inset 0 3px var(--platform-color); }
.platform-monogram { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid color-mix(in srgb, var(--platform-color) 45%, transparent); border-radius: 10px; background: color-mix(in srgb, var(--platform-color) 12%, var(--color-card)); color: var(--color-foreground); font: 700 20px/1 monospace; }
.publishing-platforms b { color: var(--color-foreground); font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; }
.publishing-full-service { margin-bottom: 64px; }
.publishing-service-heading { display: grid; grid-template-columns: 1.25fr 1fr; gap: 40px; align-items: center; margin-bottom: 28px; }
.publishing-service-heading h2 { margin-bottom: 0; }
.publishing-support-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
.publishing-support-grid article { padding: 24px 0 0; border-top: 2px solid var(--svc-accent); }
.publishing-support-grid article:nth-child(2) { border-color: var(--color-violet); }
.publishing-support-grid article:nth-child(3) { border-color: var(--color-amber); }
.publishing-service-number { display: block; margin-bottom: 24px; color: var(--color-muted-foreground); font: 13px/1 monospace; }
.publishing-support-grid h3 { margin: 0 0 10px; font-size: 18px; line-height: 1.4; font-weight: 600; letter-spacing: -.02em; }
@media (max-width: 760px) {
 .publishing-reach { padding: 26px; margin-bottom: 45px; }
 .publishing-sdk, .publishing-service-heading { grid-template-columns: 1fr; gap: 18px; }
 .publishing-sdk-link { padding: 0; }
 .publishing-platforms { grid-template-columns: repeat(2, minmax(0, 1fr)); }
 .publishing-full-service { margin-bottom: 45px; }
 .publishing-support-grid { grid-template-columns: 1fr; gap: 20px; }
 .publishing-service-number { margin-bottom: 14px; }
}
@media (max-width: 480px) {
 .publishing-reach { padding: 22px; }
 .publishing-platforms { gap: 10px; }
 .publishing-platforms li { padding: 18px 12px; gap: 14px; }
 .publishing-platforms b { font-size: 12px; }
}
</style>
