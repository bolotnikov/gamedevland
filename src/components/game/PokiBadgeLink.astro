---
import { Locale } from '../../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
interface Props {
	href: string;
	gameTitle: string;
}

const { href, gameTitle } = Astro.props;
---

<a
	class="poki-badge-link"
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={t("Play {game} on Poki", {game: gameTitle})}
>
	<img src="/assets/poki/poki-badge_dark.svg" alt="" width="136" height="40" />
</a>

<style>
	.poki-badge-link {
		display: inline-flex;
		width: 136px;
		height: 40px;
		border-radius: 6px;
	}

	.poki-badge-link:focus-visible {
		outline: 3px solid rgba(255, 255, 255, 0.65);
		outline-offset: 4px;
	}

	.poki-badge-link img {
		width: 136px;
		height: 40px;
	}
</style>
