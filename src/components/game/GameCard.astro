---
import { Locale } from '../../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
interface Props {
	title: string;
	description: string;
	badgeLabel?: string | undefined;
	releaseLabel?: string | undefined;
	genre: string;
	technologies: string[];
	iconImage: string;
	iconAlt: string;
	squareIcon?: boolean;
	href: string;
}

const { title, description, badgeLabel, releaseLabel, genre, technologies, iconImage, iconAlt, squareIcon, href } = Astro.props;
---

<article class="game-card">
	<a class:list={['game-card__link', { 'game-card__link--square-icon': squareIcon }]} href={href}>
		<div class="game-card__media">
			<img src={iconImage} alt={iconAlt} width="900" height="900" loading="eager" />
		</div>
		<div class="game-card__body">
			<div class="game-card__meta">
				{badgeLabel && <span class="game-card__status">{badgeLabel}</span>}
				<span>{genre}</span>
				{releaseLabel && <span>{releaseLabel}</span>}
			</div>
			<h2>{title}</h2>
			<p>{description}</p>
			{
				technologies.length > 0 && (
					<ul class="game-card__stack" aria-label={t("Main technologies")}>
						{technologies.slice(0, 3).map((technology) => <li>{technology}</li>)}
					</ul>
				)
			}
			<span class="game-card__cta">{t("View game ")}<span aria-hidden="true">{t("&rarr;")}</span></span>
		</div>
	</a>
</article>

<style>
	.game-card {
		width: min(100%, 360px);
	}

	.game-card__link {
		display: block;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-card);
		box-shadow: var(--shadow-card);
		text-decoration: none;
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease,
			border-color 0.25s ease;
	}

	.game-card__link:hover {
		transform: translateY(-3px);
		border-color: rgba(16, 24, 40, 0.18);
		box-shadow: var(--shadow-card-hover);
	}

	.game-card__link--square-icon {
		border-start-start-radius: 0;
		border-start-end-radius: 0;
	}

	.game-card__link:focus-visible {
		outline: 3px solid var(--color-ring);
		outline-offset: 4px;
	}

	.game-card__media {
		aspect-ratio: 1;
		overflow: hidden;
		background: var(--color-accent);
	}

	.game-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.game-card__body {
		padding: 24px;
	}

	.game-card__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 12px;
		margin-bottom: 14px;
		font-size: 13px;
		color: var(--color-muted-foreground);
	}

	.game-card__status {
		padding: 6px 9px;
		border-radius: 8px;
		background: var(--color-primary);
		color: var(--color-primary-foreground);
		font-weight: 600;
	}

	h2 {
		margin: 0 0 10px;
		font-size: 25px;
		line-height: 1.25;
		letter-spacing: 0;
	}

	p {
		margin: 0;
		font-size: 15px;
		line-height: 1.7;
		color: var(--color-muted-foreground);
	}

	.game-card__stack {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 18px 0 0;
		padding: 0;
		list-style: none;
	}

	.game-card__stack li {
		padding: 7px 9px;
		border-radius: 8px;
		background: var(--color-accent);
		font-size: 12px;
		font-weight: 500;
	}

	.game-card__cta {
		display: inline-flex;
		gap: 8px;
		margin-top: 20px;
		font-size: 14px;
		font-weight: 600;
	}

	@media (prefers-reduced-motion: reduce) {
		.game-card__link {
			transition: none;
		}

		.game-card__link:hover {
			transform: none;
		}
	}
</style>
