---
import { Locale } from '../../i18n/Locale';
import type { PlaygamaPublication } from '../../data/playgamaPublications';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
import PokiBadgeLink from './PokiBadgeLink.astro';

interface Props {
	title: string;
	playableUrl?: string | undefined;
	externalUrl?: string | undefined;
	playgama?: PlaygamaPublication | undefined;
}

const {
	title,
	playableUrl,
	externalUrl,
	playgama,
} = Astro.props;
---

<section class="game-embed" aria-labelledby="play-game-heading">
	<div class="game-embed__bar">
		<div>
			<p class="game-embed__eyebrow">{t("Playable build")}</p>
			<h2 id="play-game-heading">{t("Play ")}{title}</h2>
		</div>
		<div class="game-embed__actions">
			{playgama && (
				<a class="game-embed__platform" href={playgama.url} target="_blank" rel="noopener noreferrer">
					{t("Play on Playgama")}
				</a>
			)}
			{externalUrl && <PokiBadgeLink href={externalUrl} gameTitle={title} />}
			{playableUrl && <a class="game-embed__local" href={playableUrl} target="_blank" rel="noopener noreferrer">
				{playgama || externalUrl ? t("Open GameDev.Land build") : t("Open game in new tab")}
			</a>}
		</div>
	</div>

	{
		!playableUrl && (
			<p class="game-embed__fallback">{t("The web build is not available yet.")}</p>
		)
	}
	{playgama && (
		<details class="game-embed__credit">
			<summary>{t("Playgama credit")}</summary>
			<p>
				Made with AI. Brought to you by #PlaygamaMCP. Fine-tuned by me. {playgama.title} →{' '}
				<a href={playgama.url} target="_blank" rel="noopener noreferrer">{playgama.url}</a><br />
				#playgama #PlaygamaMCP #webdev #gamedev
			</p>
		</details>
	)}
</section>

<style>
	.game-embed {
		overflow: hidden;
		border: 1px solid #263142;
		border-radius: 8px;
		background: #0d1117;
		box-shadow: 0 24px 56px rgba(16, 24, 40, 0.16);
	}

	.game-embed__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		min-height: 78px;
		padding: 14px 18px;
		color: #ffffff;
	}

	.game-embed__eyebrow {
		margin: 0 0 4px;
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		color: #a9b4c4;
	}

	h2 {
		margin: 0;
		font-size: 20px;
		line-height: 1.3;
		letter-spacing: 0;
	}

	.game-embed__actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 16px;
		flex-wrap: wrap;
	}

	.game-embed__local {
		font-size: 13px;
		font-weight: 600;
		color: #ffffff;
		text-underline-offset: 4px;
	}

	.game-embed__platform {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0 14px;
		border-radius: 6px;
		background: #d0f4e3;
		color: #0d3025;
		font-size: 14px;
		font-weight: 700;
		text-decoration: none;
	}

	.game-embed__platform:hover {
		background: #e5fff3;
	}

	.game-embed__credit {
		padding: 12px 18px;
		border-top: 1px solid #263142;
		color: #ffffff;
		font-size: 14px;
	}

	.game-embed__credit summary {
		width: fit-content;
		cursor: pointer;
		font-weight: 600;
	}

	.game-embed__credit p {
		margin: 10px 0 2px;
		color: #c7d2e2;
		overflow-wrap: anywhere;
	}

	.game-embed__credit a {
		color: #d0f4e3;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.game-embed__actions > :global(a:focus-visible) {
		outline: 3px solid rgba(255, 255, 255, 0.65);
		outline-offset: 4px;
	}

	.game-embed__fallback {
		margin: 0;
		padding: 32px 18px;
		color: #a9b4c4;
	}

	@media (max-width: 680px) {
		.game-embed__bar {
			align-items: flex-start;
			flex-direction: column;
		}

		.game-embed__actions {
			justify-content: flex-start;
		}

	}

</style>
