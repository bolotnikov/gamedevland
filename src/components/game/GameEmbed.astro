---
import { Locale } from '../../i18n/Locale';
import type { PlaygamaPublication } from '../../data/playgamaPublications';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
import PokiBadgeLink from './PokiBadgeLink.astro';

interface Props {
	title: string;
	playableUrl?: string | undefined;
	externalUrl?: string | undefined;
	playgama?: PlaygamaPublication | undefined;
	orientation?: 'landscape' | 'portrait' | 'adaptive';
	embedAspectRatio?: string;
	fitToViewport?: boolean;
}

const {
	title,
	playableUrl,
	externalUrl,
	playgama,
	orientation = 'landscape',
	embedAspectRatio = '16 / 9',
	fitToViewport = false,
} = Astro.props;
---

<section class:list={['game-embed', fitToViewport && 'is-viewport-fit']} aria-labelledby="play-game-heading">
	<div class="game-embed__bar">
		<div>
			<p class="game-embed__eyebrow">{t("Playable build")}</p>
			<h2 id="play-game-heading">{t("Play ")}{title}</h2>
		</div>
		<div class="game-embed__actions">
			{playgama && (
				<a class="game-embed__platform" href={playgama.url} target="_blank" rel="noopener noreferrer">
					{t("Play on Playgama")}
				</a>
			)}
			{externalUrl && <PokiBadgeLink href={externalUrl} gameTitle={title} />}
			{playableUrl && <a class="game-embed__local" href={playableUrl} target="_blank" rel="noopener noreferrer">
				{playgama || externalUrl ? t("Open GameDev.Land build") : t("Open game in new tab")}
			</a>}
		</div>
	</div>

	{
		playableUrl ? (
			<div
				class:list={['game-embed__frame', orientation === 'adaptive' && 'is-adaptive']}
				style={`--embed-aspect-ratio: ${embedAspectRatio}`}
			>
				<iframe
					src={playableUrl}
					title={`${t("Play")} ${title}`}
					loading="eager"
					allow="fullscreen"
					allowfullscreen
					referrerpolicy="strict-origin-when-cross-origin"
				></iframe>
			</div>
		) : (
			<p class="game-embed__fallback">{t("The web build is not available yet.")}</p>
		)
	}
	{playgama && (
		<details class="game-embed__share">
			<summary>{t("Share your game")}</summary>
			<p>{playgama.shareText}</p>
		</details>
	)}
</section>

<style>
	.game-embed {
		overflow: hidden;
		border: 1px solid #263142;
		border-radius: 8px;
		background: #0d1117;
		box-shadow: 0 24px 56px rgba(16, 24, 40, 0.16);
	}

	.game-embed.is-viewport-fit {
		width: min(100%, calc((100svh - 132px) * 0.75), 540px);
		margin-inline: auto;
	}

	.game-embed__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		min-height: 78px;
		padding: 14px 18px;
		color: #ffffff;
	}

	.game-embed__eyebrow {
		margin: 0 0 4px;
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		color: #a9b4c4;
	}

	h2 {
		margin: 0;
		font-size: 20px;
		line-height: 1.3;
		letter-spacing: 0;
	}

	.game-embed__actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 16px;
		flex-wrap: wrap;
	}

	.game-embed__local {
		font-size: 13px;
		font-weight: 600;
		color: #ffffff;
		text-underline-offset: 4px;
	}

	.game-embed__platform {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0 14px;
		border-radius: 6px;
		background: #d0f4e3;
		color: #0d3025;
		font-size: 14px;
		font-weight: 700;
		text-decoration: none;
	}

	.game-embed__platform:hover {
		background: #e5fff3;
	}

	.game-embed__share {
		padding: 12px 18px;
		border-top: 1px solid #263142;
		color: #ffffff;
		font-size: 14px;
	}

	.game-embed__share summary {
		width: fit-content;
		cursor: pointer;
		font-weight: 600;
	}

	.game-embed__share p {
		margin: 10px 0 2px;
		color: #c7d2e2;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.game-embed__actions > :global(a:focus-visible) {
		outline: 3px solid rgba(255, 255, 255, 0.65);
		outline-offset: 4px;
	}

	.game-embed__frame {
		width: 100%;
		aspect-ratio: var(--embed-aspect-ratio);
		background: #07090d;
	}

	iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.game-embed__fallback {
		margin: 0;
		padding: 32px 18px;
		color: #a9b4c4;
	}

	@media (max-width: 680px) {
		.game-embed__bar {
			align-items: flex-start;
			flex-direction: column;
		}

		.game-embed__actions {
			justify-content: flex-start;
		}

	}

	@media (max-width: 900px) and (orientation: portrait) {
		.game-embed__frame.is-adaptive {
			aspect-ratio: 9 / 16;
		}
	}
</style>
