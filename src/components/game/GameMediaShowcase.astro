---
interface Screenshot {
	title: string;
	landscapeSrc: string;
	landscapeAlt: string;
	portraitSrc: string;
	portraitAlt: string;
}

interface PromoVideo {
	landscapeWebm: string;
	landscapeMp4: string;
	portraitWebm: string;
	portraitMp4: string;
	landscapePoster: string;
	portraitPoster: string;
}

interface Props {
	screenshots: Screenshot[];
	promoVideo?: PromoVideo;
}

const { screenshots, promoVideo } = Astro.props;
---

<section class="media-showcase" aria-labelledby="media-showcase-heading">
	<div class="media-showcase__heading">
		<p>Portrait and landscape</p>
		<h2 id="media-showcase-heading">Made for every screen</h2>
	</div>

	{
		screenshots.length > 0 && (
			<div class="media-showcase__gallery">
				{screenshots.map((screenshot) => (
					<figure>
						<div class="media-showcase__pair">
							<img
								class="is-landscape"
								src={screenshot.landscapeSrc}
								alt={screenshot.landscapeAlt}
								width="2560"
								height="1440"
								loading="lazy"
							/>
							<img
								class="is-portrait"
								src={screenshot.portraitSrc}
								alt={screenshot.portraitAlt}
								width="1440"
								height="2560"
								loading="lazy"
							/>
						</div>
						<figcaption>{screenshot.title}</figcaption>
					</figure>
				))}
			</div>
		)
	}

	{
		promoVideo && (
			<div class="media-showcase__video">
				<h3>Gameplay preview</h3>
				<video
					controls
					playsinline
					preload="metadata"
					poster={promoVideo.landscapePoster}
					data-responsive-promo-video
					data-landscape-poster={promoVideo.landscapePoster}
					data-portrait-poster={promoVideo.portraitPoster}
				>
					<source
						src={promoVideo.portraitWebm}
						type="video/webm"
						media="(max-width: 900px) and (orientation: portrait)"
					/>
					<source src={promoVideo.landscapeWebm} type="video/webm" />
					<source
						src={promoVideo.portraitMp4}
						type="video/mp4"
						media="(max-width: 900px) and (orientation: portrait)"
					/>
					<source src={promoVideo.landscapeMp4} type="video/mp4" />
				</video>
			</div>
		)
	}
</section>

<style>
	.media-showcase {
		padding: 72px 0 0;
	}

	.media-showcase__heading {
		margin-bottom: 28px;
	}

	.media-showcase__heading p {
		margin: 0 0 8px;
		font-size: 12px;
		font-weight: 600;
		text-transform: uppercase;
		color: var(--color-muted-foreground);
	}

	h2,
	h3 {
		margin: 0;
		letter-spacing: 0;
	}

	h2 {
		font-size: 32px;
		line-height: 1.25;
	}

	.media-showcase__gallery {
		display: grid;
		gap: 36px;
	}

	figure {
		margin: 0;
	}

	.media-showcase__pair {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(180px, 0.32fr);
		gap: 16px;
		align-items: stretch;
	}

	.media-showcase__pair img {
		width: 100%;
		height: 100%;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: var(--color-accent);
		object-fit: cover;
	}

	.media-showcase__pair .is-landscape {
		aspect-ratio: 16 / 9;
	}

	.media-showcase__pair .is-portrait {
		aspect-ratio: 9 / 16;
	}

	figcaption {
		margin-top: 10px;
		font-size: 14px;
		color: var(--color-muted-foreground);
	}

	.media-showcase__video {
		margin-top: 64px;
	}

	.media-showcase__video h3 {
		margin-bottom: 18px;
		font-size: 24px;
	}

	video {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 8px;
		background: #0d1117;
		object-fit: contain;
	}

	@media (max-width: 720px) {
		.media-showcase {
			padding-top: 56px;
		}

		.media-showcase__pair {
			grid-template-columns: 1fr;
		}

		.media-showcase__pair .is-portrait {
			width: min(100%, 320px);
			justify-self: center;
		}

	}

	@media (max-width: 900px) and (orientation: portrait) {
		video {
			aspect-ratio: 9 / 16;
		}
	}
</style>

<script>
	const promoVideos = document.querySelectorAll<HTMLVideoElement>('[data-responsive-promo-video]');
	const portraitMedia = window.matchMedia('(max-width: 900px) and (orientation: portrait)');

	const updatePromoPosters = () => {
		for (const video of promoVideos) {
			if (video.currentTime > 0) continue;

			const attribute = portraitMedia.matches ? 'data-portrait-poster' : 'data-landscape-poster';
			const poster = video.getAttribute(attribute);
			if (poster) video.poster = poster;
		}
	};

	updatePromoPosters();
	portraitMedia.addEventListener('change', updatePromoPosters);
</script>
