---
// Russian review draft; the English lesson retains its existing simulation until translation.
const instructions = ['LOAD_ARGUMENT a', 'ADD_ARGUMENT b', 'RETURN'];
const states = [
	{
		handler: 'Ещё не выбран', operation: 'Первая инструкция — LOAD_ARGUMENT a.',
		accumulator: '—', previousAccumulator: undefined, result: '—', previousResult: undefined,
		note: 'Аргументы a = 2 и b = 3 уже доступны. Выполним первую инструкцию: загрузим a в аккумулятор.',
		next: 'Выполнить LOAD_ARGUMENT a →',
	},
	{
		handler: 'LOAD_ARGUMENT', operation: 'Записать значение a в аккумулятор.',
		accumulator: '2', previousAccumulator: '—', result: '—', previousResult: undefined,
		note: 'Ignition прочитал LOAD_ARGUMENT a и выбрал обработчик. CPU выполнил его машинный код: в аккумулятор записано 2. Далее — ADD_ARGUMENT b.',
		next: 'Выполнить ADD_ARGUMENT b →',
	},
	{
		handler: 'ADD_ARGUMENT', operation: 'Прибавить b к аккумулятору: 2 + 3 = 5.',
		accumulator: '5', previousAccumulator: '2', result: '—', previousResult: undefined,
		note: 'Ignition прочитал ADD_ARGUMENT b и выбрал обработчик. CPU выполнил сложение: аккумулятор изменился с 2 на 5. Далее — RETURN.',
		next: 'Выполнить RETURN →',
	},
	{
		handler: 'RETURN', operation: 'Вернуть значение аккумулятора: 5.',
		accumulator: '5', previousAccumulator: undefined, result: '5', previousResult: '—',
		note: 'CPU выполнил обработчик RETURN. Функция вернула значение аккумулятора — 5. Выполнение add(2, 3) завершено.',
		next: 'Выполнение завершено',
	},
];
---
<section class="simulation interpreter-trace" data-simulation aria-label="Как Ignition выполняет add(2, 3)">
	<h2>Как Ignition выполняет add(2, 3)</h2>
	<p class="simulation__hint">Одно нажатие — одна инструкция. Псевдобайткод и имена обработчиков — учебные.</p>
	<div class="interpreter-trace__arguments"><code>a = 2</code><code>b = 3</code><span>Аккумулятор хранит промежуточный результат.</span></div>
	{states.map((state, index) => (
		<div data-simulation-state hidden={index !== 0} data-next-label={state.next} data-state-counter={`Выполнено ${index} из 3`}>
			<div class="interpreter-trace__workspace">
				<div class="interpreter-trace__bytecode">
					<h3>Байткод</h3>
					<ol aria-label="Инструкции учебного байткода">
						{instructions.map((instruction, line) => (
							<li class:list={{'is-executed': line < index, 'is-latest': line === index - 1, 'is-next': line === index}}>
								<span class="interpreter-trace__line-number" aria-hidden="true">{line + 1}</span>
								<code>{instruction}</code>
								<span class="interpreter-trace__line-status">{line < index ? '✓ Выполнена' : line === index ? '→ Следующая' : 'Ожидает'}</span>
							</li>
						))}
					</ol>
				</div>
				<div class:list={['interpreter-trace__handler', index > 0 && 'is-active']}>
					<h3>CPU</h3>
					<p>Выполняет машинный код Ignition</p>
					<span class="interpreter-trace__handler-label">{index === 0 ? 'Обработчик' : 'Выполнен обработчик'}</span>
					<strong>{state.handler}</strong>
					<p>{state.operation}</p>
				</div>
			</div>
			<dl class="interpreter-trace__values">
				<div class:list={{'is-changed': state.previousAccumulator !== undefined}}>
					<dt>Аккумулятор {state.previousAccumulator !== undefined && <span>Изменился</span>}</dt>
					<dd>{state.previousAccumulator !== undefined && <><span class="interpreter-trace__before">{state.previousAccumulator}</span><span class="interpreter-trace__value-arrow" aria-label="теперь">→</span></>}<strong>{state.accumulator}</strong></dd>
				</div>
				<div class:list={{'is-changed': state.previousResult !== undefined}}>
					<dt>Результат функции {state.previousResult !== undefined && <span>Возвращён</span>}</dt>
					<dd>{state.previousResult !== undefined && <><span class="interpreter-trace__before">{state.previousResult}</span><span class="interpreter-trace__value-arrow" aria-label="теперь">→</span></>}<strong>{state.result}</strong></dd>
				</div>
			</dl>
			<p class="simulation__note" data-state-note>{state.note}</p>
		</div>
	))}
	<div class="simulation__controls interpreter-trace__controls">
		<div><button class="academy-button is-secondary" type="button" data-simulation-reset>↺ Сначала</button><button class="academy-button is-secondary" type="button" data-simulation-previous disabled>← Назад</button></div>
		<span class="simulation__count" data-simulation-count>Выполнено 0 из 3</span>
		<button class="academy-button" type="button" data-simulation-next>Выполнить LOAD_ARGUMENT a →</button>
	</div>
	<span class="sr-only" aria-live="polite" data-simulation-announcement></span>
</section>

<style>
	.interpreter-trace__arguments { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 18px 0; }
	.interpreter-trace__arguments code { font-size: 12px; padding: 6px 10px; border-radius: 6px; background: var(--color-code); border: 1px solid var(--color-border); }
	.interpreter-trace__arguments > span { font-size: 11px; line-height: 1.7; color: var(--color-muted-foreground); margin-left: 4px; }
	.interpreter-trace__workspace { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 16px; }
	.interpreter-trace__bytecode, .interpreter-trace__handler { min-width: 0; padding: 16px; background: var(--color-code); border: 1px solid var(--color-border); border-radius: 12px; }
	.interpreter-trace h3 { font-size: 12px; line-height: 1.6; font-weight: 600; margin: 0 0 12px; }
	.interpreter-trace__bytecode ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
	.interpreter-trace__bytecode li { display: grid; grid-template-columns: 16px minmax(0, 1fr); align-items: center; gap: 4px 8px; border: 1px solid transparent; border-radius: 7px; padding: 10px; color: var(--color-muted-foreground); }
	.interpreter-trace__bytecode li.is-next { border-color: var(--color-cyan); border-style: dashed; color: var(--color-cyan); }
	.interpreter-trace__bytecode li.is-latest { border-color: var(--color-green); background: color-mix(in srgb, var(--color-green) 9%, var(--color-code)); color: var(--color-green); }
	.interpreter-trace__bytecode code { font: 11px/1.7 ui-monospace, monospace; overflow-wrap: anywhere; }
	.interpreter-trace__line-number { font: 10px/1.7 ui-monospace, monospace; opacity: .7; }
	.interpreter-trace__line-status { grid-column: 2; font-size: 10px; line-height: 1.6; }
	.interpreter-trace__handler.is-active { border-color: var(--color-violet); background: color-mix(in srgb, var(--color-violet) 5%, var(--color-code)); }
	.interpreter-trace__handler h3 { margin-bottom: 2px; color: var(--color-violet); }
	.interpreter-trace__handler p { font-size: 12px; line-height: 1.8; color: var(--color-muted-foreground); margin: 0; }
	.interpreter-trace__handler-label { display: block; font-size: 10px; line-height: 1.7; color: var(--color-muted-foreground); margin: 26px 0 6px; }
	.interpreter-trace__handler strong { display: block; font: 600 15px/1.6 ui-monospace, monospace; color: var(--color-foreground); margin-bottom: 10px; overflow-wrap: anywhere; }
	.interpreter-trace__values { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 16px 0 0; }
	.interpreter-trace__values > div { min-width: 0; border: 1px solid var(--color-border); border-radius: 10px; padding: 14px 16px; background: var(--color-code); }
	.interpreter-trace__values > div.is-changed { border-color: var(--color-green); background: color-mix(in srgb, var(--color-green) 8%, var(--color-code)); }
	.interpreter-trace__values dt { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; color: var(--color-muted-foreground); font-size: 11px; line-height: 1.7; }
	.interpreter-trace__values dt > span { color: var(--color-green); font-size: 9px; font-weight: 600; }
	.interpreter-trace__values dd { display: flex; align-items: center; gap: 12px; margin: 10px 0 0; min-height: 38px; font: 28px/1.3 ui-monospace, monospace; }
	.interpreter-trace__values dd strong { font-weight: 500; color: var(--color-foreground); }
	.interpreter-trace__values .is-changed dd strong { color: var(--color-green); }
	.interpreter-trace__before, .interpreter-trace__value-arrow { font-size: 19px; color: var(--color-muted-foreground); }
	.interpreter-trace .simulation__note { min-height: 44px; margin: 14px 0; padding: 0; }
	.interpreter-trace__controls { flex-wrap: wrap; }
	.interpreter-trace__controls > div { display: flex; flex-wrap: wrap; gap: 6px; }
	.interpreter-trace__controls [data-simulation-next] { font-size: 10px; }
	@media (max-width: 600px) {
		.interpreter-trace__workspace { grid-template-columns: minmax(0, 1fr); gap: 12px; }
		.interpreter-trace__bytecode, .interpreter-trace__handler { padding: 14px; }
		.interpreter-trace__arguments > span { flex-basis: 100%; margin: 0; }
		.interpreter-trace__handler-label { margin-top: 16px; }
		.interpreter-trace__values { gap: 8px; }
		.interpreter-trace__values > div { padding: 12px; }
		.interpreter-trace__values dd { gap: 8px; font-size: 24px; }
		.interpreter-trace__controls { display: grid; grid-template-columns: 1fr auto; }
		.interpreter-trace__controls [data-simulation-next] { grid-column: 1 / -1; width: 100%; }
	}
</style>
