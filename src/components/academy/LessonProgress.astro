---
import { Locale } from '../../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
interface Props { total: number }
const { total } = Astro.props;
---
<div class="lesson-progress">
	<div><span>{t("Пройдено шагов")}</span><strong data-progress-count>0 / {total}</strong></div>
	<progress value="0" max={total} data-lesson-progress aria-label={t("Пройдено шагов")}></progress>
	<small data-progress-status>{t("Прогресс хранится в этом браузере")}</small>
</div>
