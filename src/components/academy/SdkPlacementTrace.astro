---
import { Locale } from '../../i18n/Locale';
const locale = Locale.forPath(Astro.url.pathname);
const t = locale.t.bind(locale);
---
<section class="sdk-placement" data-sdk-placement aria-labelledby="placement-title">
	<h2 id="placement-title">{t("Один ход в FSM")}</h2>
	<p>{t("Сокращённая конфигурация Block Puzzle. Разместим фигуру и проследим, какие правила FSM выполняет по очереди.")}</p>
	<div class="sdk-placement__path" aria-label={t("Правила FSM для успешного хода")}>
		<div class="sdk-placement__node tone-cyan is-current" data-fsm-node="playing" aria-current="step">
			<strong>playing</strong><span class="sdk-placement__current">{t("Текущее состояние")}</span>
			<div class="sdk-placement__rule" data-fsm-rule="placement"><small>{t("Событие")}</small><code>PlacementRequested</code><small>{t("Команда")}</small><code>PlaceBlockCommand</code><small>{t("Переход")}</small><code>resolvingPlacement</code></div>
		</div>
		<div class="sdk-placement__node tone-violet" data-fsm-node="resolvingPlacement">
			<strong>resolvingPlacement</strong><span class="sdk-placement__current">{t("Текущее состояние")}</span>
			<div class="sdk-placement__rule" data-fsm-rule="completed"><small>{t("Событие")}</small><code>PlacementCompleted</code><small>{t("Переход")}</small><code>checkingMoves</code></div>
		</div>
		<div class="sdk-placement__node tone-green" data-fsm-node="checkingMoves">
			<strong>checkingMoves</strong><span class="sdk-placement__current">{t("Текущее состояние")}</span>
			<div class="sdk-placement__rule" data-fsm-rule="check"><small>{t("При входе")}</small><code>CheckBlockPuzzleMovesCommand</code></div>
			<div class="sdk-placement__rule" data-fsm-rule="moves"><small>{t("Событие")}</small><code>MovesAvailable</code><small>{t("Переход")}</small><code>playing</code></div>
		</div>
	</div>
	<div class="sdk-placement__queue"><span>{t("Событие в очереди")}</span><code data-fsm-queue>{t("нет")}</code></div>
	<div class="sdk-placement__explanation" aria-live="polite" aria-atomic="true"><strong data-fsm-title>{t("Ожидание хода")}</strong><p data-fsm-status>{t("FSM находится в playing и ждёт запроса на размещение.")}</p></div>
	<button type="button" class="academy-button" data-fsm-advance>{t("Разместить фигуру")}</button>
</section>
<script>
	import { SdkPlacementController } from '../../scripts/SdkPlacementController';
	document.querySelectorAll<HTMLElement>('[data-sdk-placement]').forEach((root) => new SdkPlacementController(root));
</script>
