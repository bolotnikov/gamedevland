---
import { Locale } from '../../i18n/Locale';
import { sdkApi } from '../../data/sdkApi';
const locale = Locale.forPath(Astro.url.pathname);
const t = locale.t.bind(locale);
const guides = {
	assets: ['foundations/asset-manifest', 'Ресурсы и наборы'],
	audio: ['presentation/audio', 'Звук'],
	commands: ['scene-flow/commands', 'Команды'],
	configs: ['foundations/config-store', 'Конфигурация и сохранения'],
	core: ['foundations/game-config', 'Запуск движка'],
	di: ['scene-flow/dependency-injection', 'Внедрение зависимостей'],
	errors: ['scene-flow/diagnostics', 'Диагностика'],
	events: ['scene-flow/events', 'События'],
	fsm: ['scene-flow/fsm', 'Конечный автомат'],
	input: ['presentation/input', 'Ввод'],
	interactions: ['presentation/drag', 'Перетаскивание'],
	layouts: ['presentation/layouts', 'Вёрстка и узлы'],
	physics: ['presentation/physics', 'Физика'],
	particles: ['presentation/particles', 'Частицы'],
	platforms: ['integrations/platforms', 'Платформы'],
	prefabs: ['presentation/prefabs', 'Префабы'],
	scenes: ['scene-flow/scenes', 'Сцены'],
	screen: ['presentation/screen', 'Адаптивность'],
	tween: ['presentation/tweens', 'Анимации'],
	validation: ['foundations/schema-decoder', 'Проверка данных'],
	rendering: ['rendering/renderers', 'Режимы рендеринга'],
	'renderers/pixi': ['rendering/pixi-only', 'Pixi-only'],
	'renderers/three': ['rendering/three-only', 'Three-only'],
	'renderers/hybrid': ['rendering/three-pixi', 'Three + Pixi'],
} as const;
---
<details class="sdk-api sdk-api__module">
	<summary>{t('Открыть список модулей SDK')} <span>{sdkApi.length}</span></summary>
	{sdkApi.map((group) => (
		<details class="sdk-api__module" id={`api-${group.name}`}>
			<summary><code>@gamedevland/engine/{group.name}</code><span>{group.exports.length}</span></summary>
			<a class="sdk-api__guide" href={locale.path(`/academy/sdk/${guides[group.name][0]}/`)}>{t(guides[group.name][1])} →</a>
			<ul>{group.exports.map((item) => <li><code>{item.name}</code><small>{item.kind === 'type' ? t('тип') : 'API'}</small></li>)}</ul>
		</details>
	))}
	<h3>{t('Инструменты Vite')}</h3>
	<p><code>createGameViteConfig</code>, <code>GameViteConfig</code>, <code>GameViteConfigFactory</code>, <code>GameViteConfigFactoryOptions</code></p>
	<p><a href={locale.path('/academy/sdk/integrations/build-tooling/')}>{t('Сборка ZIP для Poki')}</a> · <a href={locale.path('/academy/sdk/integrations/poki-upload/')}>{t('Загрузка в Poki')}</a></p>
</details>
