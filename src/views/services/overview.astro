---
import { Locale } from '../../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import ServiceGraphic from '../../components/services/ServiceGraphic.astro';
import ServiceContact from '../../components/services/ServiceContact.astro';
import ServiceProof from '../../components/services/ServiceProof.astro';
import { ServiceCatalog } from '../../data/ServiceCatalog';
const catalog = new ServiceCatalog(i18n);
const servicePages = catalog.pages();
const copy = catalog.overview();
import '../../styles/services.css';
const groups = [
 { id: 'development', number: '01', title: t("Professional game development"), description: t("From an idea or brief to a working project."), className: 'group-development' },
 { id: 'porting', number: '02', title: copy.porting, description: copy.portingDescription, className: 'group-porting' },
];
const lead = servicePages.find(page => page.group === 'lead');
if (!lead) throw new Error('Missing Tech Lead service');
---
<Layout title={copy.title} description={copy.description} canonicalPath="/services/">
 <Header title={t("Services")} description={copy.header} current="services" navigationOnly/>
 <main class="svc-page svc-overview">
  <section class="container svc-hero overview-hero" aria-labelledby="services-title">
   <div class="svc-hero-copy"><span class="svc-eyebrow"><span class="svc-square" aria-hidden="true"></span>{t("GameDev.Land / Services")}</span><h1 id="services-title">{t("HTML5 games")}<br/><em>{t("Playable Ads")}</em></h1><p class="svc-intro">{copy.intro}</p><div class="svc-hero-actions"><a class="svc-button" href="#directions">{t("Explore services")} <span aria-hidden="true">↓</span></a><a class="svc-text-link" href="#contact">{t("Discuss a project")} <span aria-hidden="true">↗</span></a></div><div class="svc-byline"><span></span>{t("Alexander Bolotnikov · HTML5 developer and Tech Lead")}</div></div>
   <ServiceGraphic kind="overview" showcase={catalog.overviewShowcase()}/>
  </section>
  <div class="svc-strip"><div class="container"><span>{t("Development from scratch")}</span><i aria-hidden="true">/</i><span>{t("HTML5 porting")}</span><i aria-hidden="true">/</i><span>{copy.strip}</span></div></div>
  <div class="container svc-directions" id="directions">
   {groups.map(group => <section class:list={['svc-group', group.className]} aria-labelledby={`group-${group.id}`}><div class="svc-group-heading"><span class="svc-group-number">{group.number}</span><div><h2 id={`group-${group.id}`}>{group.title}</h2><p>{group.description}</p></div></div><div class:list={['svc-service-grid', group.id === 'porting' && 'single-service']}>{servicePages.filter(page => page.group === group.id).map(page => <a class:list={['svc-service-card', `card-${page.graphic}`]} href={i18n.path(`/services/${page.slug}/`)}><div class="service-card-top"><span>{page.number} / {page.group === 'development' ? t("Development") : copy.porting}</span><span class="service-card-arrow" aria-hidden="true">↗</span></div><div class:list={['service-card-art', `card-art-${page.graphic}`]} aria-hidden="true">{page.graphic === 'games' && <><span class="card-bracket">&lt;</span><span class="card-game-grid">{Array.from({length:9},(_,i)=><i class:list={[i % 3 === 0 && 'lit']}></i>)}</span><span class="card-bracket">/&gt;</span></>}{page.graphic === 'playable' && <><span class="card-play">▶</span><span class="card-play-track"><i></i><i></i><i></i></span></>}{page.graphic === 'port' && <><b>Unity / Flash</b><span>→</span><b class="art-html">HTML5</b></>}</div><h3>{page.label}</h3><p>{page.summary}</p><span class="service-card-bottom">{t("Explore this service")} <span aria-hidden="true">→</span></span></a>)}</div></section>)}
   <section class="svc-lead-banner" aria-labelledby="lead-title"><div class="lead-banner-portrait"><img src="/ava2.jpg" alt={t("Alexander Bolotnikov")} width="100" height="100" loading="lazy"/></div><div><span class="svc-eyebrow">{t("For employers")}</span><h2 id="lead-title">{t("Technical leadership")}</h2><p>{t("An HTML5 game or playable ads team: architecture, tools and development process.")}</p></div><a class="svc-button svc-button-secondary" href={i18n.path(`/services/${lead.slug}/`)}>{t("Experience and working arrangements")} <span aria-hidden="true">↗</span></a></section>
   <ServiceProof/>
   <ServiceContact description={t("Start with a game link or a short description of the idea. I will review the task and suggest a next step.")}/>
  </div>
 </main>
 <Footer/>
</Layout>
