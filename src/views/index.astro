---
import { Locale } from '../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import EngineMark from '../components/academy/EngineMark.astro';
import { javascriptCourse } from '../data/academy';
import CyberUiMark from '../components/academy/CyberUiMark.astro';
import { cyberUiCourse } from '../data/cyberUiCourse';
import { sdkCourse } from '../data/sdkCourse';
import SdkMark from '../components/academy/SdkMark.astro';
import { Content } from '../i18n/Content';
import '../styles/academy.css';
import '../styles/sdk-course.css';
const steps = await Content.steps(i18n.code);
const sdkSteps = await Content.steps(i18n.code, 'sdk');
const cyberSteps = await Content.steps(i18n.code, 'cyber-ui');
---
<Layout title={t("Курсы — GameDev.Land")} description={t("Интерактивные курсы для разработчиков HTML5-игр: глубокая теория, наглядные модели и инженерная практика.")} lang={i18n.code} canonicalPath="/">
	<Header title={t("Глубокое понимание разработки игр.")} description={t("Инженерные знания для тех, кто строит игры.")} current="home" />
	<main class="academy-page container">
		<div class="academy-section-heading"><h2>{t("Курсы")}</h2><span>{t("Курсов: {value0}", {value0: 1 + Number(sdkSteps.length > 0) + Number(cyberSteps.length > 0)})}</span></div>

		{sdkSteps.length > 0 && <a href={i18n.path("/academy/sdk/")} class="course-card"><div class="course-card__art is-sdk"><SdkMark/><span class="course-card__series">TYPESCRIPT / HTML5</span></div><div class="course-card__body"><div class="academy-chips"><span class="academy-chip">TypeScript · PixiJS</span></div><h2>{sdkCourse.title}</h2><p>{t(sdkCourse.description)}</p><div class="course-card__meta"><span>{t("{value0} раздела · {value1} уроков", {value0: sdkCourse.sections.length, value1: sdkSteps.length})}</span><span>Engine · Vite</span></div><div class="course-card__cta">{t("Открыть курс ")}<span>↗</span></div></div></a>}
		{cyberSteps.length > 0 && <a href={i18n.path('/academy/cyber-ui/')} class="course-card"><div class="course-card__art is-sdk"><CyberUiMark/><span class="course-card__series">PIXIJS / UI</span></div><div class="course-card__body"><div class="academy-chips"><span class="academy-chip">TypeScript · PixiJS 8</span></div><h2>{cyberUiCourse.title}</h2><p>{t(cyberUiCourse.description)}</p><div class="course-card__meta"><span>{t('Уроков: {value0}', {value0: cyberSteps.length})}</span><span>{t('Панели · иконки · эффекты')}</span></div><div class="course-card__cta">{t('Открыть курс ')}<span>↗</span></div></div></a>}
		<a href={i18n.path("/academy/javascript/")} class="course-card">
			<div class="course-card__art"><EngineMark /><span class="course-card__series">{t("JAVASCRIPT / 01")}</span></div>
			<div class="course-card__body"><div class="academy-chips"><span class="academy-chip">{t("JavaScript")}</span></div><h2>{t(javascriptCourse.title)}</h2><p>{t(javascriptCourse.description)}</p><div class="course-card__meta"><span>{t("{value0} уроков", {value0: steps.length})}</span><span>{t("Пошаговый формат")}</span></div><div class="course-card__cta">{t("Открыть курс ")}<span>↗</span></div></div>
		</a>
	</main>
	<Footer />
</Layout>
