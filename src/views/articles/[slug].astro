---
import { Locale } from '../../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
import CodeBlockEnhancer from '../../components/article/CodeBlockEnhancer.astro';
import Footer from '../../components/common/Footer.astro';
import Header from '../../components/common/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { render, type CollectionEntry } from 'astro:content';



interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const tableOfContents = headings.filter((heading) => heading.depth === 2);

const categoryLabels = {
	technical: t('Tutorial'),
	monetization: t('Monetization'),
	template: t('Template'),
	workshop: t('Workshop'),
};
---

<Layout title={`${article.data.title} | HTML5 Game Dev Blog`} description={article.data.description}>
	<Header
		title={t("HTML5 Game Development")}
		description={t("Project walkthroughs, architecture notes, and implementation details from real HTML5 game builds.")}
		current="home"
	/>

	<main class="page-main article-page">
		<section class="container">
			<div class="article-page__header">
				<a class="article-page__back" href={i18n.path("/")}>{t("← Back to home")}</a>
				<div class="article-page__tag">{categoryLabels[article.data.category]}</div>
				<h1 class="article-page__title">{article.data.title}</h1>
				<div class="article-page__meta">
					<time>
						{article.data.pubDate.toLocaleDateString(i18n.dateLocale, {
							day: 'numeric',
							month: 'long',
								timeZone: 'UTC',
							year: 'numeric',
						})}
					</time>
				</div>
			</div>

			<div class="article-page__hero">
				{
					article.data.coverImage ? (
						<img src={article.data.coverImage} alt={article.data.coverAlt ?? article.data.title} />
					) : (
						<div class="article-page__hero-fallback"></div>
					)
				}
			</div>

			{
				article.data.tableOfContents ? (
					<div class="article-with-toc-layout">
						<aside class="article-toc">
							<div class="article-toc__inner">
								<div class="article-toc__header">
									<div class="article-toc__eyebrow">{t("Contents")}</div>
									<h2>{t("On this page")}</h2>
									<p>{article.data.readingTime}</p>
								</div>
								<nav class="article-toc__nav" aria-label={t("Article contents")}>
									{tableOfContents.map((heading, index) => (
										<a class="article-toc__link" href={i18n.path(`#${heading.slug}`)}>
											<span>{String(index + 1).padStart(2, '0')}</span>
											<strong>{heading.text}</strong>
										</a>
									))}
								</nav>
							</div>
						</aside>

						<div class="article-prose article-with-toc__content">
							<Content />
						</div>
					</div>
				) : (
					<div class="article-prose">
						<Content />
					</div>
				)
			}
		</section>
	</main>

	<Footer />
	<CodeBlockEnhancer />
	<script>
		const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.article-toc__link'));
		const tocSections = tocLinks
			.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
			.filter((section): section is HTMLElement => section !== null);

		if (tocLinks.length > 0 && tocSections.length > 0) {
			const setActiveLink = (id: string) => {
				tocLinks.forEach((link) => {
					const isActive = decodeURIComponent(link.hash.slice(1)) === id;
					link.classList.toggle('is-active', isActive);
					if (isActive) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
				});
			};

			const updateActiveLink = () => {
				const marker = Math.min(240, window.innerHeight * 0.35);
				let activeSection = tocSections[0];

				for (const section of tocSections) {
					if (section.getBoundingClientRect().top > marker) break;
					activeSection = section;
				}

				if (activeSection) setActiveLink(activeSection.id);
			};

			let updateScheduled = false;
			const scheduleUpdate = () => {
				if (updateScheduled) return;
				updateScheduled = true;
				requestAnimationFrame(() => {
					updateScheduled = false;
					updateActiveLink();
				});
			};

			window.addEventListener('scroll', scheduleUpdate, { passive: true });
			window.addEventListener('hashchange', scheduleUpdate);
			requestAnimationFrame(updateActiveLink);
		}
	</script>
</Layout>
