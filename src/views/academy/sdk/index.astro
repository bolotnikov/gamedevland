---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/common/Header.astro';
import Footer from '../../../components/common/Footer.astro';
import SdkMark from '../../../components/academy/SdkMark.astro';
import { sdkCourse } from '../../../data/sdkCourse';
import { Content } from '../../../i18n/Content';
import { Locale } from '../../../i18n/Locale';
import '../../../styles/academy.css';
import '../../../styles/sdk-course.css';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
const steps = await Content.steps(i18n.code, 'sdk');
---
<Layout title={t('GameDevLand SDK — Обучение')} description={t(sdkCourse.description)} canonicalPath="/academy/sdk/">
	<Header title="GameDevLand SDK" description="" current="academy" navigationOnly/>
	<main class="academy-page container sdk-course">
		<nav class="academy-breadcrumb" aria-label={t('Навигация')}><a href={i18n.path('/academy/')}>{t('Обучение')}</a><span>/</span><span>GameDevLand SDK</span></nav>
		<div class="course-hero"><div><span class="academy-eyebrow">{t('Курс / TypeScript · HTML5')}</span><h1>GameDevLand SDK</h1><p>{t(sdkCourse.description)}</p><div class="academy-chips"><span class="academy-chip">{t('{value0} раздела · {value1} уроков', {value0: sdkCourse.sections.length, value1: steps.length})}</span><span class="academy-chip">Engine · Vite</span><span class="academy-chip">{t('Русский и английский')}</span></div><a class="academy-button" href={i18n.path('/academy/sdk/foundations/')}>{t('Начать курс →')}</a></div><SdkMark/></div>
		<section aria-labelledby="sdk-program"><div class="academy-section-heading"><h2 id="sdk-program">{t('Программа курса')}</h2></div><ol class="curriculum">{sdkCourse.sections.map((section, index) => <li class:list={[!section.published && 'is-planned']}>
			{section.published ? <a href={i18n.path(`/academy/sdk/${section.slug}/`)}><span class="curriculum__number">{String(index + 1).padStart(2, '0')}</span><div><span class="academy-eyebrow">{t('Уроков: {value0}', {value0: steps.filter(({data}) => data.lesson === section.slug).length})}</span><h3>{t(section.title)}</h3><p>{t(section.description)}</p></div><span class="curriculum__arrow" aria-hidden="true">↗</span></a> : <div class="curriculum__row sdk-section-locked" aria-disabled="true"><span class="curriculum__number">{String(index + 1).padStart(2, '0')}</span><div><span class="sdk-section-status">{t('В разработке')}</span><h3>{t(section.title)}</h3><p>{t(section.description)}</p></div></div>}
		</li>)}</ol></section>
		<div class="sdk-reading-grid"><section><h2>{t('Что потребуется')}</h2><p>{t('Основы TypeScript, классов, Promise и npm. Опыт с PixiJS пригодится в третьем разделе. Для нового проекта — Node.js 22.12+ или 24.')}</p><p>{t('Разберём подключение SDK и работу с его API. Уроки можно изучать по порядку или выбирать в содержании раздела.')}</p></section><section><h2>{t('Пакеты и примеры')}</h2><ul class="sdk-links"><li><a href={`https://github.com/gamedevland/block-puzzle/tree/${sdkCourse.gameRevision}`} target="_blank" rel="noopener noreferrer">{t('Пример игры: Block Puzzle · исходники ↗')}</a></li><li><a href="https://gamedevland.github.io/block-puzzle/" target="_blank" rel="noopener noreferrer">{t('Открыть Block Puzzle ↗')}</a></li><li><a href="https://www.npmjs.com/package/@gamedevland/engine" target="_blank" rel="noopener noreferrer">{t('Engine в npm ↗')}</a></li><li><a href="https://www.npmjs.com/package/@gamedevland/vite" target="_blank" rel="noopener noreferrer">{t('Vite в npm ↗')}</a></li></ul></section></div>
	</main><Footer/>
</Layout>
