---
import { Locale } from '../../../../i18n/Locale';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/common/Header.astro';
import Footer from '../../../../components/common/Footer.astro';
import CodeBlockEnhancer from '../../../../components/article/CodeBlockEnhancer.astro';
import Simulation from '../../../../components/academy/Simulation.astro';
import Assessment from '../../../../components/academy/Assessment.astro';
import LessonProgress from '../../../../components/academy/LessonProgress.astro';
import '../../../../styles/academy.css';

interface Props { step: CollectionEntry<'academy'>; steps: CollectionEntry<'academy'>[]; index: number }
const { step, steps, index } = Astro.props;
const { Content } = await render(step);
const previous = steps[index - 1];
const next = steps[index + 1];
const slug = step.data.translationKey.split('/').at(-1);
---
<Layout title={`${step.data.title} — ${t("JavaScript Engine")} | ${t("Academy")}`} description={step.data.description || step.data.title} lang={i18n.code} canonicalPath={i18n.path(`/academy/${step.data.translationKey}/`)}>
	<Header title={t("JavaScript Engine")} description="" current="academy" navigationOnly/>
	<main class="lesson-shell container" data-lesson-step={slug} data-total={steps.length} data-step-slugs={steps.map((entry) => entry.data.translationKey.split('/').at(-1)).join(',')}>
		<aside class="lesson-sidebar">
			<a class="lesson-sidebar__back" href={i18n.path("/academy/javascript/")}>{t("← К программе курса")}</a>
			<div class="lesson-sidebar__heading"><span class="academy-eyebrow">{t("JavaScript / Урок 01")}</span><a href={i18n.path("/academy/javascript/engine/")}>{t("Как работает")}<br/>{t("JavaScript Engine")}</a><LessonProgress total={steps.length}/></div>
			<details class="lesson-toc" open><summary>{t("Содержание урока ")}<span>{steps.length}{t(" шагов")}</span></summary><nav aria-label={t("Шаги урока")}>{steps.map((entry) => <a href={i18n.path(`/academy/${entry.data.translationKey}/`)} class:list={['lesson-toc__link', entry.data.translationKey === step.data.translationKey && 'is-current']} aria-current={entry.data.translationKey === step.data.translationKey ? 'step' : undefined} data-step-link={entry.data.translationKey.split('/').at(-1)}><span>{String(entry.data.order).padStart(2,'0')}</span><strong>{entry.data.title}</strong><span class="step-done" aria-label={t("Шаг пройден")}>✓</span></a>)}</nav></details>
		</aside>
		<div class="lesson-content">
			<nav class="academy-breadcrumb" aria-label={t("Навигация")}><a href={i18n.path("/academy/")}>{t("Academy")}</a><span>/</span><a href={i18n.path("/academy/javascript/")}>{t("JavaScript")}</a><span>/</span><a href={i18n.path("/academy/javascript/engine/")}>{t("Engine")}</a></nav>
			<div class="step-topline"><span class="academy-eyebrow">{step.data.concept}</span><span class="step-position">{String(step.data.order).padStart(2,'0')} <span>/ {steps.length}</span></span></div>
			<article class="lesson-article"><h1>{step.data.title}</h1>{step.data.description && <p class="step-description">{step.data.description}</p>}<div class="article-prose lesson-prose"><Content /></div></article>
			{step.data.simulation && <Simulation id={step.data.simulation}/>}
			{step.data.assessment && <Assessment kind={step.data.assessment}/>}
			<div class="lesson-takeaway"><span>{t("Основной вывод")}</span>{Array.isArray(step.data.takeaway) ? <ol>{step.data.takeaway.map((item) => <li>{item}</li>)}</ol> : <p>{step.data.takeaway}</p>}</div>
			<section class="lesson-sources" aria-label={t("Первоисточники")}><h2>{t("Проверить по первоисточнику ")}<span>↗</span></h2>{step.data.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer"><strong>{source.title}<span>↗</span></strong><span>{source.note}</span></a>)}</section>
			<nav class="step-pagination" aria-label={t("Управление уроком")}><a class="academy-button is-secondary" href={i18n.path(previous ? `/academy/${previous.data.translationKey}/` : '/academy/javascript/engine/')}>← {t(previous ? 'Назад' : 'Об уроке')}</a><span>{step.data.order}{t(" из ")}{steps.length}</span>{next ? <a class="academy-button" href={i18n.path(`/academy/${next.data.translationKey}/`)} data-complete-step>{t("Отметить шаг и продолжить →")}</a> : <button class="academy-button" type="button" data-complete-step>{t("Завершить просмотр ✓")}</button>}</nav>
			<p class="completion-message" aria-live="polite" data-completion-message></p>
			<noscript><p class="lesson-takeaway">{t("Текст и навигация доступны без JavaScript. Для симуляций и сохранения прогресса необходимо включить JavaScript.")}</p></noscript>
		</div>
	</main><Footer/><CodeBlockEnhancer/>
	<script>import { LessonController } from '../../../../scripts/LessonController'; new LessonController();</script>
</Layout>
