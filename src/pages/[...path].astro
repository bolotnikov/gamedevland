---
import { getCollection, type CollectionEntry } from 'astro:content';
import Home from '../views/index.astro';
import About from '../views/about.astro';
import Services from '../views/services.astro';
import Games from '../views/games/index.astro';
import Game from '../views/games/[slug].astro';
import Article from '../views/articles/[slug].astro';
import Tutorial from '../views/Tutorial.astro';
import Course from '../views/academy/javascript/index.astro';
import Lesson from '../views/academy/javascript/engine/index.astro';
import Step from '../views/academy/javascript/engine/[step].astro';
import SdkCourse from '../views/academy/sdk/index.astro';
import SdkSection from '../views/academy/sdk/section.astro';
import SdkStep from '../views/academy/sdk/step.astro';
import { cyberUiCourse } from '../data/cyberUiCourse';
import { sdkCourse } from '../data/sdkCourse';
import { locales, type LocaleCode } from '../i18n/locales';
import { Locale } from '../i18n/Locale';
import { Content } from '../i18n/Content';

type Route =
 | { kind: 'home' | 'about' | 'services' | 'games' | 'course' | 'lesson' }
 | { kind: 'game'; entry: CollectionEntry<'games'> }
 | { kind: 'article'; entry: CollectionEntry<'articles'> }
 | { kind: 'tutorial'; entry: CollectionEntry<'tutorials'> }
 | { kind: 'cyber-ui-course' }
 | { kind: 'sdk-course' }
 | { kind: 'sdk-section'; section: string }
 | { kind: 'step'; entry: CollectionEntry<'academy'>; steps: CollectionEntry<'academy'>[]; index: number };
interface Props { route: Route }
export async function getStaticPaths() {
 const articles = await getCollection('articles', ({data}) => !data.draft);
 const games = await getCollection('games', ({data}) => !data.draft);
 const tutorials = await getCollection('tutorials');
 const academy = await getCollection('academy');
 const publishedAcademy = academy.filter(({data}) => Content.isAcademyPublished(data));
 const visibleAcademy = academy.filter(({data}) => Content.isAcademyVisible(data));
 const assertTranslations = (name: string, entries: readonly { id: string; data: { locale: LocaleCode; translationKey: string } }[]) => {
  const reference = entries.filter(({data}) => data.locale === 'en').map(({data})=>data.translationKey).sort();
  for (const language of locales) {
   const actual = entries.filter(({data})=>data.locale===language.code).map(({data})=>data.translationKey).sort();
   if (new Set(actual).size !== actual.length || JSON.stringify(actual) !== JSON.stringify(reference)) throw new Error(`Incomplete ${name} translations for ${language.code}`);
  }
  for (const entry of entries) if (entry.id !== `${entry.data.locale}/${entry.data.translationKey.replace(/\/index$/, '')}`) throw new Error(`Invalid localized content identity: ${entry.id}; expected ${entry.data.locale}/${entry.data.translationKey}`);
 };
 assertTranslations('articles', articles);
 assertTranslations('games', games);
 assertTranslations('tutorials', tutorials);
 assertTranslations('academy', publishedAcademy);
 for (const entry of academy.filter(({data}) => data.draft)) {
  if (!['sdk', 'cyber-ui'].includes(entry.data.course) || entry.data.locale !== 'ru') throw new Error(`Unsupported Academy draft: ${entry.id}`);
  if (entry.id !== `${entry.data.locale}/${entry.data.translationKey}`) throw new Error(`Invalid draft identity: ${entry.id}`);
 }
 const paths: { params: { path: string | undefined }; props: Props }[] = [];
 for (const language of locales) {
  const i18n = new Locale(language.code);
  const add = (url: string, route: Route) => paths.push({params:{path:i18n.path(url).replace(/^\//,'').replace(/\/$/,'') || undefined},props:{route}});
  for(const [url,kind] of [['/','home'],['/about','about'],['/services','services'],['/games','games'],['/academy/javascript','course'],['/academy/javascript/engine','lesson']] as const) add(url,{kind});
  for(const entry of games.filter(({data})=>data.locale===language.code)) add(`/games/${entry.data.translationKey}`,{kind:'game',entry});
  const localTutorials=tutorials.filter(({data})=>data.locale===language.code);
  const series=new Set(localTutorials.map(({data})=>data.seriesSlug));
  for(const entry of articles.filter(({data})=>data.locale===language.code&&!series.has(data.translationKey))) add(`/articles/${entry.data.translationKey}`,{kind:'article',entry});
  for(const entry of localTutorials) add(`/articles/${entry.data.translationKey.replace(/\/index$/,'')}`,{kind:'tutorial',entry});
  const visible=visibleAcademy.filter(({data})=>data.locale===language.code);
  const groups = new Map<string, CollectionEntry<'academy'>[]>();
  for (const entry of visible) {
   const key = `${entry.data.course}/${entry.data.lesson}`;
   const group = groups.get(key) ?? [];
   group.push(entry);
   groups.set(key, group);
  }
  for (const [key, entries] of groups) {
   const steps=entries.sort((a,b)=>a.data.order-b.data.order);
   if(steps.some((step,index)=>step.data.order!==index+1))throw new Error(`Invalid step ordering for ${language.code}/${key}`);
   for(const [index,entry] of steps.entries()) add(`/academy/${entry.data.translationKey}`,{kind:'step',entry,steps,index});
  }
  if (groups.has('cyber-ui/interface')) {
   add('/academy/cyber-ui', { kind: 'cyber-ui-course' });
  }
  if (groups.has('sdk/foundations')) {
   add('/academy/sdk', {kind:'sdk-course'});
   for (const section of sdkCourse.sections) {
    if (!groups.has(`sdk/${section.slug}`)) {
     if (section.published) throw new Error(`Empty SDK section: ${section.slug}`);
     continue;
    }
    add(`/academy/sdk/${section.slug}`, {kind:'sdk-section',section:section.slug});
   }
  }
 }
 return paths;
}
const { route } = Astro.props;
if ((route.kind === 'step' && route.entry.data.draft)
 || (route.kind === 'sdk-section' && sdkCourse.sections.some((section) => section.slug === route.section && !section.published))) {
 Astro.locals.availableLocales = ['ru'];
 Astro.locals.academyDraft = true;
}
---
{route.kind === 'home' && <Home/>}
{route.kind === 'about' && <About/>}
{route.kind === 'services' && <Services/>}
{route.kind === 'games' && <Games/>}
{route.kind === 'course' && <Course/>}
{route.kind === 'lesson' && <Lesson/>}
{route.kind === 'game' && <Game game={route.entry}/>}
{route.kind === 'article' && <Article article={route.entry}/>}
{route.kind === 'tutorial' && <Tutorial tutorial={route.entry}/>}
{route.kind === 'cyber-ui-course' && <SdkSection sectionSlug="interface" definition={cyberUiCourse} courseOverview/>}
{route.kind === 'sdk-course' && <SdkCourse/>}
{route.kind === 'sdk-section' && <SdkSection sectionSlug={route.section}/>}
{route.kind === 'step' && (route.entry.data.course !== 'javascript' ? <SdkStep step={route.entry} steps={route.steps} index={route.index} definition={route.entry.data.course === 'cyber-ui' ? cyberUiCourse : sdkCourse}/> : <Step step={route.entry} steps={route.steps} index={route.index}/>)}
